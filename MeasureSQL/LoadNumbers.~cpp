                       viewLoad1->Clear();
                       viewNumbers->Clear();
                       S2=DataModule1->Numberall->FieldByName("Msk")->AsString;
                       Smax=DataModule1->Numberall->FieldByName("Position")->AsString;
                       Smin=DataModule1->Numberall->FieldByName("Position")->AsString;
                        viewLoad1->Items->Add(S2);
                          for(int i=0;i<DataModule1->Numberall->RecordCount;i++){
                               if (Smax<DataModule1->Numberall->FieldByName("Position")->AsString){
