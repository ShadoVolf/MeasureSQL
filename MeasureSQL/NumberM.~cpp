AnsiString S,S1;
S=gridNumbers->Cells[2][2];
n=S.Length();
    if (n==4){
          for (int i=0;i<k;i++){
                     gridNumbers->Cells[2][i+1]=edtSerial->Text+gridNumbers->Cells[2][i+1];
                              }
            }
    if (n==6){
              for (int i=0;i<k;i++){
                    S1=gridNumbers->Cells[2][i+1];
                    gridNumbers->Cells[2][i+1]=edtSerial->Text+S1.SubString(3,4);
               }
     }
     
}
