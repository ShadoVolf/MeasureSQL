void __fastcall TNumberMForm::Get_MSK_NUMBERSExecute(TObject *Sender)
{
         AnsiString Sql1="Select `N`,`Begin`,`End` from marker where `MSK`='"+edtMSK->Text+"'";

                    RQ_Data->Marker->Active=false;
                    RQ_Data->Marker->SQL->Clear();
                    RQ_Data->Marker->SQL->Add(Sql1);
                    RQ_Data->Marker->Active=true;
                    RQ_Data->Marker->First();

                    AnsiString BeginN=RQ_Data->Marker->FieldByName("Begin")->AsString;
                    AnsiString EndN=RQ_Data->Marker->FieldByName("End")->AsString;
                    if (BeginN.Length()>5){
                          Marker_Serial=BeginN.SubString(1,2);
                          Marker_Begin=BeginN.SubString(3,BeginN.Length()-1);
                         

                    }
             edtBegin->Text=Marker_Begin;
             edtSerial->Text=Marker_Serial;
}
