void __fastcall TProtokol_Select_Form::AdvGlassButton1Click(
      TObject *Sender)
{
  DataModule2->Print->Active=true;
  DataModule2->Print->First();


  if (edtName->ItemIndex==-1){
   DataModule2->Print->Append();
   DataModule2->Print->FieldByName("Name")->AsString=edtName->Text;
  }
  else {
   for (int i=0;i<DataModule2->Print->RecordCount; i++){
    if (edtName->Text==DataModule2->Print->FieldByName("Name")->AsString){

       break;
       }
       DataModule2->Print->Next();

  }
   DataModule2->Print->Edit();

  }
  DataModule2->Print->FieldByName("Measure")->AsString=RzComboBox1->Text;
  DataModule2->Print->FieldByName("ReportOTK")->AsString=RzComboBox2->Text;
  DataModule2->Print->FieldByName("Print")->AsString=RzComboBox3->Text;
