  DataModule2->Print->FieldByName("VP_Z")->AsString=RzComboBox5->Text;
  DataModule2->Print->FieldByName("Old")->AsString=RzComboBox7->Text;
  DataModule2->Print->FieldByName("PassportPmi")->AsString=RzComboBox8->Text;
  DataModule2->Print->FieldByName("passport")->AsString=RzComboBox9->Text;
  DataModule2->Print->FieldByName("VP-RK")->AsString=RzComboBox10->Text;
  DataModule2->Print->FieldByName("PR")->AsString=RzComboBox11->Text;
  DataModule2->Print->FieldByName("VP(PSI)")->AsString=RzComboBox12->Text;
  DataModule2->Print->FieldByName("Print(PSI)")->AsString=RzComboBox13->Text;
  DataModule2->Print->FieldByName("ETK")->AsString=RzComboBox14->Text;
  DataModule2->Print->FieldByName("VP-RK(ETK)")->AsString=RzComboBox15->Text;
  DataModule2->Print->Post();
  DataModule2->Print->Active=false;
