void __fastcall TMRecForm::RzStringGrid1KeyPress(TObject *Sender,
      char &Key)
{
TGridRect NewSel ;
int Row=RzStringGrid1->Row;
int Col=RzStringGrid1->Col;
    if (Key==13){


if (Col<RzStringGrid1->ColCount-1){
    NewSel.Left=Col+1;
    NewSel.Right=Col+1;
    NewSel.Top=Row;
    NewSel.Bottom=Row;
    RzStringGrid1->Selection= NewSel;
    }
     else {
     NewSel.Left=1;
    NewSel.Right=1;
    NewSel.Top=Row+1;
    NewSel.Bottom=Row+1;
    RzStringGrid1->Selection= NewSel;
  }
}
}
