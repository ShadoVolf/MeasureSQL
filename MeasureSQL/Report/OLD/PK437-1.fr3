BDataset3.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;  &#13;&#10;IF &#60;frxDBDataset3.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;frxDBDataset3.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;frxDBDataset3.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;frxDBDataset3.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;frxDBDataset3.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;frxDBDataset3.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;frxDBDataset3.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;frxDBDataset3.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;  &#13;&#10;IF &#60;frxDBDataset3.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;frxDBDataset3.&#34;Fmax&#34;&#62;)-StrToFloat(&#60;frxDBDataset3.&#34;DopuskFT&#34;&#62;)  &#13;&#10;IF &#60;frxDBDataset3.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;frxDBDataset3.&#34;Fmin&#34;&#62;)+StrToFloat(&#60;frxDBDataset3.&#34;DopuskFT&#34;&#62;)  &#13;&#10;&#13;&#10;IF &#60;frxDBDataset3.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;frxDBDataset3.&#34;C0max&#34;&#62;)-Abs(StrToFloat(&#60;frxDBDataset3.&#34;C0max&#34;&#62;))*StrToFloat(&#60;frxDBDataset3.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;frxDBDataset3.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;frxDBDataset3.&#34;C0min&#34;&#62;)+Abs(StrToFloat(&#60;frxDBDataset3.&#34;C0min&#34;&#62;))*StrToFloat(&#60;frxDBDataset3.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;  &#13;&#10;IF &#60;frxDBDataset3.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;frxDBDataset1.&#34;F&#34;&#62;&#62; Fmax Then countf=countf+1&#13;&#10;IF &#60;frxDBDataset3.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;frxDBDataset1.&#34;F&#34;&#62;&#60; Fmin Then countf=countf+1&#13;&#10;IF &#60;frxDBDataset3.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;frxDBDataset1.&#34;R&#34;&#62;&#62; Rmax Then countR=countR+1&#13;&#10;IF &#60;frxDBDataset3.&#34;Rmin&#34;&#62;&#60;&#62;