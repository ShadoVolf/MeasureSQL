<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40623.4751934954" ReportOptions.Description.Text="" ReportOptions.LastChange="44308.5718228241" ScriptLanguage="BasicScript" ScriptText.Text="Dim count1 As Integer&#13;&#10;Dim countF1 As Integer&#13;&#10;Dim countF2 As Integer    &#13;&#10;Dim temp As Integer&#13;&#10;Dim countBad As Integer    &#13;&#10;&#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;count1=count1+1&#13;&#10;temp=0    &#13;&#10;IF &#60;SpcSpektr.&#34;Old1max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old1&#34;&#62;&#62; StrToFloat(&#60;SpcSpektr.&#34;old1max&#34;&#62;) Then countF1=countF1+1&#13;&#10;IF &#60;SpcSpektr.&#34;Old1max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old1&#34;&#62;&#62; StrToFloat(&#60;SpcSpektr.&#34;old1max&#34;&#62;) Then temp=1&#13;&#10;IF &#60;SpcSpektr.&#34;Old1min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old1&#34;&#62;&#60; StrToFloat(&#60;SpcSpektr.&#34;old1min&#34;&#62;) Then countF1=countF1+1&#13;&#10;IF &#60;SpcSpektr.&#34;Old1min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old1&#34;&#62;&#60; StrToFloat(&#60;SpcSpektr.&#34;old1min&#34;&#62;) Then temp=1&#13;&#10;&#13;&#10;IF &#60;SpcSpektr.&#34;Old2max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old2&#34;&#62;&#62; StrToFloat(&#60;SpcSpektr.&#34;Old2max&#34;&#62;) Then countF2=countF2+1&#13;&#10;IF &#60;SpcSpektr.&#34;Old2max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old2&#34;&#62;&#62; StrToFloat(&#60;SpcSpektr.&#34;Old2max&#34;&#62;) Then temp=1&#13;&#10;IF &#60;SpcSpektr.&#34;Old2min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old2&#34;&#62;&#60; StrToFloat(&#60;SpcSpektr.&#34;Old2min&#34;&#62;) Then countF2=countF2+1&#13;&#10;IF &#60;SpcSpektr.&#34;Old2min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;OldSpektr.&#34;old2&#34;&#62;&#60; StrToFloat(&#60;SpcSpektr.&#34;Old2min&#34;&#62;) Then temp=1    &#13;&#10;  &#13;&#10;IF temp=1 Then countBad=countBad+1                                             &#13;&#10;Memo23.Text=IntToStr(countF1)&#13;&#10;Memo24.Text=IntToStr(count1-countF2)&#13;&#10;Memo36.Text=IntToStr(countF2)&#13;&#10;Memo25.Text=IntToStr(count1-countF2)    &#13;&#10;Memo26.Text=IntToStr(count1-countBad)&#13;&#10;Memo27.Text=IntToStr(countBad)  &#13;&#10;  &#13;&#10;IF temp=1 Then Memo50.Color=clSilver                              &#13;&#10;IF temp=0 Then Memo50.Color=clNone&#13;&#10;IF temp=1 Then Memo49.Color=clSilver                              &#13;&#10;IF temp=0 Then Memo49.Color=clNone&#13;&#10;IF temp=1 Then Memo24.Color=clSilver                              &#13;&#10;IF temp=0 Then Memo24.Color=clNone    &#13;&#10;IF temp=1 Then OldStatus.Color=clSilver                              &#13;&#10;IF temp=0 Then OldStatus.Color=clNone    &#13;&#10;&#13;&#10;end sub" PropData="">
