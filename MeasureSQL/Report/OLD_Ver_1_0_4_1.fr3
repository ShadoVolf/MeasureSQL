3;&#10;IF &#60;Old.&#34;Status&#34;&#62;=&#34;����&#34; Then OldStatus.Color=clSilver                              &#13;&#10;IF &#60;Old.&#34;Status&#34;&#62;=&#34;�����&#34; Then OldStatus.Color=clNone    &#13;&#10;&#13;&#10;end sub" PropData="">
