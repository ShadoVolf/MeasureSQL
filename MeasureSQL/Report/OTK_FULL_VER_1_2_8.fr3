<TfrxReport Version="4.9" DataSetName="frxUserDataSet1" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39953.7254732639" ReportOptions.Description.Text="" ReportOptions.LastChange="43388.6197172801" ScriptLanguage="BasicScript" ScriptText.Text="Dim countf As Longint                                                               &#13;&#10;Dim count1 As Integer&#13;&#10;Dim countRmax As Integer&#13;&#10;Dim countFmax AS Integer&#13;&#10;Dim countFmin As Integer&#13;&#10;Dim countC0 As Integer&#13;&#10;Dim countCq As Integer&#13;&#10;Dim countM As Integer&#13;&#10;Dim countS As Integer    &#13;&#10;Dim countR As Integer    &#13;&#10;Dim temp As Integer&#13;&#10;Dim temp1 As Integer&#13;&#10;  &#13;&#10;Dim countBad As Integer&#13;&#10;Dim countBadUsl As Integer&#13;&#10;Dim countBadAn As Integer    &#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended&#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim Mmax As Extended&#13;&#10;Dim Mmin As Extended&#13;&#10;Dim Smax As Extended&#13;&#10;Dim Smin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended    &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;count1=count1+1&#13;&#10;temp=0    &#13;&#10;temp1=0&#13;&#10;Memo112.Text=&#34;&#34;&#13;&#10;Memo113.Text=&#34;&#34;&#13;&#10;Memo114.Text=&#34;&#34;&#13;&#10;Memo115.Text=&#34;&#34;&#13;&#10;Memo116.Text=&#34;&#34;&#13;&#10;Memo117.Text=&#34;&#34;&#13;&#10;Memo118.Text=&#34;&#34;&#13;&#10;Memo119.Text=&#34;&#34;  &#13;&#10;Memo127.Text=&#34;&#34;  &#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;) Then Memo112.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;) Then Memo112.Text=&#34;**&#34;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;) Then Memo113.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;) Then Memo113.Text=&#34;**&#34;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;) Then Memo114.Text=&#34;**&#34;                         &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;) Then Memo114.Text=&#34;**&#34;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;) Then Memo115.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;) Then Memo115.Text=&#34;**&#34;  &#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;) Then Memo116.Text=&#34;**&#34;                         &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;) Then Memo116.Text=&#34;**&#34;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then Memo117.Text=&#34;**&#34;                         &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;) Then Memo117.Text=&#34;**&#34;  &#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;) Then Memo118.Text=&#34;**&#34;                         &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;) Then Memo118.Text=&#34;**&#34;  &#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Spur&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Spur&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rsp1min&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Spur&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;) Then Memo119.Text=&#34;**&#34;                         &#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Spur&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rsp1min&#34;&#62;) Then Memo119.Text=&#34;**&#34;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;) Then Memo127.Text=&#34;**&#34;                         &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;) Then Memo127.Text=&#34;**&#34;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmax=StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmin=StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100  &#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskF_P&#34;&#62;)/100  &#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskF_P&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmax=StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmin=StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; Then Smax=StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskSR&#34;&#62;)          &#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; The