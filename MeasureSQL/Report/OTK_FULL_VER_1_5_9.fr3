<TfrxReport Version="4.9" DataSetName="frxUserDataSet1" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39953.7254732639" ReportOptions.Description.Text="" ReportOptions.LastChange="42956.738316956" ScriptLanguage="BasicScript" ScriptText.Text="Dim countf As Longint                                                               &#13;&#10;Dim count1 As Integer&#13;&#10;Dim countR As Integer    &#13;&#10;Dim countFmax AS Integer&#13;&#10;Dim countFmin As Integer&#13;&#10;Dim countC0 As Integer&#13;&#10;Dim countCq As Integer&#13;&#10;Dim countM As Integer  &#13;&#10;&#13;&#10;Dim temp1 As Integer&#13;&#10;    &#13;&#10;Dim countBad As Integer&#13;&#10;Dim countBadAn As Integer    &#13;&#10;    &#13;&#10;sub Header2OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo162.Text=&#60;Spc.&#34;Fmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo163.Text=&#60;Spc.&#34;Fmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo164.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo165.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo166.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo167.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo168.Text=&#60;Spc.&#34;Fminmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo169.Text=&#60;Spc.&#34;Fminmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo170.Text=&#60;Spc.&#34;C0max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo171.Text=&#60;Spc.&#34;C0min&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo172.Text=&#60;Spc.&#34;Cqmax&#34;&#62;            &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo173.Text=&#60;Spc.&#34;Cqmin&#34;&#62;  &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo180.Text=&#60;Spc.&#34;Mmax&#34;&#62;            &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo181.Text=&#60;Spc.&#34;Mmin&#34;&#62;  &#13;&#10;end Sub&#13;&#10;  &#13;&#10;  &#13;&#10;sub MasterData2OnBeforePrint(Sender)&#13;&#10;count1=count1+1&#13;&#10;temp1=0&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;) Then countf=countf+1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;) Then countf=countf+1    &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;) Then countR=countR+1&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;) Then countR=countR+1    &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;) Then countFmax=countFmax+1                         &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmax&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;) Then countFmax=countFmax+1    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;) Then countFmin=countFmin+1&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Fmin&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;) Then countFmin=countFmin+1    &#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;) Then countC0=countC0+1                         &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;) Then countC0=countC0+1    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then countCq=countCq+1                         &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;) Then countCq=countCq+1    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;) Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;) Then countM=countM+1                         &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;) Then countM=countM+1    &#13;&#10;  &#13;&#10;Memo147.Text=IntToStr(countf)&#13;&#10;Memo146.Text=IntToStr(count1-countf)&#13;&#10;Memo149.Text=IntToStr(countR)&#13;&#10;Memo148.Text=IntToStr(count1-countR)&#13;&#10;Memo151.Text=IntToStr(countFmax)&#13;&#10;Memo150.Text=IntToStr(count1-countFmax)&#13;&#10;Memo157.Text=IntToStr(countFmin)&#13;&#10;Memo156.Text=IntToStr(count1-countFmin)    &#13;&#10;Memo153.Text=IntToStr(countC0)&#13;&#10;Memo152.Text=IntToStr(count1-countC0)&#13;&#10;Memo155.Text=IntToStr(countCq)&#13;&#10;Memo154.Text=IntToStr(count1-countCq)  &#13;&#10;Memo179.Text=IntToStr(countM)&#13;&#10;Memo178.Text=IntToStr(count1-countM)&#13;&#10;  &#13;&#10;IF temp1=1  THEN PsiDataStatus1.Text=&#34;Fail&#34;&#13;&#10;IF temp1=0  THEN PsiDataStatus1.Text=&#34;Pass&#34;&#13;&#10;IF temp1=1 Then countBad=countBad+1                                &#13;&#10;Memo160.Text=IntToStr(count1-countBad)&#13;&#10;Memo159.Text=IntToStr(countBad)  &#13;&#10;IF temp1=1  Then PsiDataF1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataF1.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataN1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataN1.Color=clNone    &#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataR1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataR1.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataFmax1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataFmax1.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataFmin1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataFmin1.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataC01.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataC01.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataCq1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataCq1.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataMono1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataMono1.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1  Then PsiDataStatus1.Color=clYellow                              &#13;&#10;IF temp1=0  Then PsiDataStatus1.Color=clNone    &#13;&#10;        &#13;&#10;end sub&#13;&#10;&#13;&#10;     &#13;&#10;sub ReportTitle2OnBeforePrint(Sender)&#13;&#10;  if &#60;PsiData.&#34;type&#34;&#62;=&#34;True&#34; Then Memo1.Text=&#34;Incoming inspection&#34;          &#13;&#10;end sub&#13;&#10;&#13;&#10;    " PropData="">
