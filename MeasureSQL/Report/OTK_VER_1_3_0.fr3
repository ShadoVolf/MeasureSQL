; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then Memo118.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;) Then Memo118.Text=&#34;**&#34;    &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;) Then Memo116.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;) Then Memo116.Text=&#34;**&#34;    &#13;&#10;IF &#60;Spc.&#34;RRmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R1R2&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;RRmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;RRmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R1R2&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;RRmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;RRmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R1R2&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;RRmax&#34;&#62;) Then Memo119.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;RRmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R1R2&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;RRmin&#34;&#62;) Then Memo119.Text=&#34;**&#34;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmax=StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskQ&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmin=StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskQ&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;RRmax&#34;&#62;&#60;&#62;&#34;no&#34; Then RRmax=StrToFloat(&#60;Spc.&#34;RRmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;RRmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;RRmin&#34;&#62;&#60;&#62;&#34;no&#34; Then RRmin=StrToFloat(&#60;Spc.&#34;RRmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;RRmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)    &#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)  &#13;&#10;&#13;&#10;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo105.Text=FloatToStr(Fmaxmax)&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo106.Text=FloatToStr(Fmaxmin)    &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo65.Text=FloatToStr(Fminmin)&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo64.Text=FloatToStr(Fminmax)&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo55.Text=FloatToStr(C0min)&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo54.Text=FloatToStr(C0max)&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo102.Text=FloatToStr(Cqmin)&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo101.Text=FloatToStr(Cqmax)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34;