<TfrxReport Version="4.9" DataSetName="frxUserDataSet1" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39953.7254732639" ReportOptions.Description.Text="" ReportOptions.LastChange="43494.6065316204" ScriptLanguage="BasicScript" ScriptText.Text="Dim countf As Longint                                                               &#13;&#10;Dim count1 As Integer&#13;&#10;Dim countR As Integer&#13;&#10;Dim countFmax AS Integer&#13;&#10;Dim countFmin As Integer&#13;&#10;Dim countC0 As Integer&#13;&#10;Dim countCq As Integer&#13;&#10;Dim countQ As Integer&#13;&#10;Dim countRR As Integer    &#13;&#10;  &#13;&#10;Dim temp As Integer&#13;&#10;Dim temp1 As Integer&#13;&#10;  &#13;&#10;Dim countBad As Integer&#13;&#10;Dim countBadUsl As Integer&#13;&#10;Dim countBadAn As Integer    &#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended&#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim Qmax As Extended&#13;&#10;Dim Qmin As Extended&#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended    &#13;&#10;    &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;count1=count1+1&#13;&#10;temp=0    &#13;&#10;temp1=0&#13;&#10;countBadAn=0          &#13;&#10;Memo112.Text=&#34;&#34;&#13;&#10;Memo113.Text=&#34;&#34;&#13;&#10;Memo114.Text=&#34;&#34;&#13;&#10;Memo115.Text=&#34;&#34;&#13;&#10;Memo116.Text=&#34;&#34;&#13;&#10;Memo117.Text=&#34;&#34;&#13;&#10;Memo118.Text=&#34;&#34;&#13;&#10;Memo119.Text=&#34;&#34;    &#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData