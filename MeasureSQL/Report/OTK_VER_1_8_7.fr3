2;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;) Then Memo112.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Ft&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;) Then Memo112.Text=&#34;**&#34;    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;) Then Memo113.Text=&#34;**&#34;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;) Then Memo113.Text=&#34;**&#34;    &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;) Then temp1=1&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;) Then Memo115.Text=&#34;**&#34;&#13;&#10;IF &#60;