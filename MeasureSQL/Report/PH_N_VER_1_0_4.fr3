<TfrxReport Version="4.9" DataSetName="frxUserDataSet1" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39953.7254732639" ReportOptions.Description.Text="" ReportOptions.LastChange="42814.8021865278" ScriptLanguage="BasicScript" ScriptText.Text="Dim countSh As Integer&#13;&#10;Dim countSh1 As Integer&#13;&#10;Dim countSh2 As Integer&#13;&#10;Dim countSh3 As Integer&#13;&#10;Dim countSh4 As Integer    &#13;&#10;Dim temp As Integer      &#13;&#10;Dim count1 As Integer    &#13;&#10;Dim countBad As Integer&#13;&#10;  &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;count1=count1+1&#13;&#10;temp=0&#13;&#10;  PhazeNoiseShum100.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum1&#34;&#62;))&#13;&#10;  Memo3.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;))&#13;&#10;  Memo18.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;))&#13;&#10;  Memo39.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;))&#13;&#10;  Memo53.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;))      &#13;&#10;IF &#60;Spc.&#34;Shum&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;ShMax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum1&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;ShMax&#34;&#62;) Then temp=1&#13;&#10;IF &#60;Spc.&#34;Shum&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;ShMin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum1&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;ShMin&#34;&#62;) Then temp=1  &#13;&#10;&#13;&#10;                &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Shum&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;ShMax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum1&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;ShMax&#34;&#62;) Then countSh=countSh+1                                   &#13;&#10;IF &#60;Spc.&#34;Shum&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;ShMin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum1&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;ShMin&#34;&#62;) Then countSh=countSh+1&#13;&#10;  &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Shum1&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh1Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh1Max&#34;&#62;) Then temp=1&#13;&#10;IF &#60;Spc.&#34;Shum1&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh1Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh1Min&#34;&#62;) Then temp=1  &#13;&#10;&#13;&#10;                &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Shum1&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh1Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum10&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh1Max&#34;&#62;) Then countSh1=countSh1+1                                   &#13;&#10;IF &#60;Spc.&#34;Shum1&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh1Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum10&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh1Min&#34;&#62;) Then countSh1=countSh1+1&#13;&#10;&#13;&#10;  &#13;&#10;  &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Shum2&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh2Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh2Max&#34;&#62;) Then temp=1&#13;&#10;IF &#60;Spc.&#34;Shum2&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh2Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh2Min&#34;&#62;) Then temp=1  &#13;&#10;&#13;&#10;                &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Shum2&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh2Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum100&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh2Max&#34;&#62;) Then countSh2=countSh2+1                                   &#13;&#10;IF &#60;Spc.&#34;Shum2&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh2Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum100&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh2Min&#34;&#62;) Then countSh2=countSh2+1  &#13;&#10;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Shum3&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh3Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh3Max&#34;&#62;) Then temp=1&#13;&#10;IF &#60;Spc.&#34;Shum3&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh3Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh3Min&#34;&#62;) Then temp=1  &#13;&#10;&#13;&#10;                &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Shum3&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh3Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum1K&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh3Max&#34;&#62;) Then countSh3=countSh3+1                                   &#13;&#10;IF &#60;Spc.&#34;Shum3&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh3Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum1K&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh3Min&#34;&#62;) Then countSh3=countSh3+1&#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Shum4&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh4Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh4Max&#34;&#62;) Then temp=1&#13;&#10;IF &#60;Spc.&#34;Shum4&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh4Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh4Min&#34;&#62;) Then temp=1  &#13;&#10;&#13;&#10;                &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Shum4&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh4Max&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum10K&#34;&#62;) &#62; StrToFloat(&#60;Spc.&#34;Sh4Max&#34;&#62;) Then countSh4=countSh4+1                                   &#13;&#10;IF &#60;Spc.&#34;Shum4&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh4Min&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum10K&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;Sh4Min&#34;&#62;) Then countSh4=countSh4+1  &#13;&#10;  &#13;&#10;Memo83.Text=IntToStr(countSh)&#13;&#10;Memo82.Text=IntToStr(count1-countSh)&#13;&#10;Memo11.Text=IntToStr(countSh1)&#13;&#10;Memo8.Text=IntToStr(count1-countSh1)&#13;&#10;Memo22.Text=IntToStr(countSh2)&#13;&#10;Memo21.Text=IntToStr(count1-countSh2)&#13;&#10;Memo48.Text=IntToStr(countSh3)&#13;&#10;Memo47.Text=IntToStr(count1-countSh3)&#13;&#10;Memo57.Text=IntToStr(countSh4)&#13;&#10;Memo56.Text=IntToStr(count1-countSh4)    &#13;&#10;IF temp=1 THEN PsiDataStatus.Text=&#34;Брак&#34;&#13;&#10;IF temp=0 THEN PsiDataStatus.Text=&#34;Годен&#34;&#13;&#10;IF temp=1 THEN countBad=countBad+1&#13;&#10;frxDBDataset2Good.Text=IntToStr(count1-countBad)  &#13;&#10;frxDBDataset2Bad.Text=IntToStr(countBad)                                &#13;&#10; IF temp=1 Then PhazeNoiseN.Color=clYellow                                    &#13;&#10; IF temp=0 Then PhazeNoiseN.Color=clNone  &#13;&#10;     &#13;&#10; IF temp=1 Then PhazeNoiseShum100.Color=clYellow                                                &#13;&#10; IF temp=0 Then PhazeNoiseShum100.Color=clNone&#13;&#10; IF temp=1 Then Memo3.Color=clYellow                                          &#13;&#10; IF temp=0 Then Memo3.Color=clNone&#13;&#10; IF temp=1 Then Memo18.Color=clYellow                                    &#13;&#10; IF temp=0 Then Memo18.Color=clNone&#13;&#10; IF temp=1 Then Memo39.Color=clYellow                                    &#13;&#10; IF temp=0 Then Memo39.Color=clNone&#13;&#10; IF temp=1 Then Memo53.Color=clYellow                                    &#13;&#10; IF temp=0 Then Memo53.Color=clNone     &#13;&#10;&#13;&#10;   &#13;&#10; IF temp=1 Then PsiDataStatus.Color=clYellow                              &#13;&#10; IF temp=0 Then PsiDataStatus.Color=clNone     &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;end sub&#13;&#10;sub Header1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Shum&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;ShMax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;ShMax&#34;&#62;)&#60;1000 Then Memo80.Text=&#60;Spc.&#34;ShMax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;ShMin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;ShMin&#34;&#62;)&#62;-1000 Then SpcShMin.Text=&#60;Spc.&#34;ShMin&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Shum1&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh1Max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh1Max&#34;&#62;)&#60;1000 Then Memo7.Text=&#60;Spc.&#34;Sh1Max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum1&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh1Min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh1Min&#34;&#62;)&#62;-1000 Then Memo15.Text=&#60;Spc.&#34;Sh1Min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum2&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh2Max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh2Max&#34;&#62;)&#60;1000 Then Memo20.Text=&#60;Spc.&#34;Sh2Max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum2&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh2Min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh2Min&#34;&#62;)&#62;-1000 Then Memo37.Text=&#60;Spc.&#34;Sh2Min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum3&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh3Max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh3Max&#34;&#62;)&#60;1000 Then Memo41.Text=&#60;Spc.&#34;Sh3Max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum3&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh3Min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh3Min&#34;&#62;)&#62;-1000 Then Memo51.Text=&#60;Spc.&#34;Sh3Min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum4&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh4Max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh4Max&#34;&#62;)&#60;1000 Then Memo55.Text=&#60;Spc.&#34;Sh4Max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Shum4&#34;&#62;=&#34;True&#34; Then IF &#60;Spc.&#34;Sh4Min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF StrToFloat(&#60;Spc.&#34;Sh4Min&#34;&#62;)&#62;-1000 Then Memo60.Text=&#60;Spc.&#34;Sh4Min&#34;&#62;&#13;&#10;IF &#60;PhazeNoise.&#34;Lot&#34;&#62;=&#34;True&#34; Then Memo63.Text=&#34;Incoming Inspection&#34;                                                                                         &#13;&#10;end sub    " PropData="044C65667403F00003546F70023008446174617365747301010C2E00000020446174615365743D225068617A654E6F6973652220446174615365744E616D653D225068617A654E6F6973652200010C2000000020446174615365743D225370632220446174615365744E616D653D22537063220000095661726961626C65730100055374796C650100">
