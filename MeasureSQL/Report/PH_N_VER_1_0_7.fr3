True&#34; Then IF &#60;Spc.&#34;ShMin&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF Abs( &#60;PhazeNoise.&#34;Shum50&#34;&#62;) &#60; StrToFloat(&#60;Spc.&#34;ShMin&#34;&#62;) Then countSh=countSh+1    &#13;&#10;    &#13;&#10;Memo83.Text=IntToStr(countSh)&#13;&#10;Memo82.Text=IntToStr(count1-countSh)&#13;&#10;&#13;&#10;IF temp=1 THEN PsiDataStatus.Text=&#34;����&#34;&#13;&#10;IF temp=0 THEN PsiDataStatus.Text=&#34;�����&#34;&#13;&#10;      &#13;&#10; IF temp=1 Then PhazeNoiseShum100.Color=clSilver                              &#13;&#10; IF temp=0 Then PhazeNoiseShum100.Color=clNone&#13;&#10; IF temp=1 Then PsiDataStatus.Color=clSilver                              &#13;&#10; IF temp=0 Then PsiDataStatus.Color=clNone     &#13;&#10;     &#13;&#10;sub Page1OnBeforePrint(Sender)&#13;&#10;                              &#13;&#10;end sub&#13;&#10;&#13;&#10;end sub  " PropData="044C65667403980003546F70021008446174617365747301010C2E00000020446174615365743D225068617A654E6F6973652220446174615365744E616D653D225068617A654E6F6973652200010C2000000020446174615365743D225370632220446174615365744E616D653D22537063220000095661726961626C65730100055374796C650100">
