     &#13;&#10; Sh1000_2max =138              &#13;&#10; Sh10000_2max =148    &#13;&#10;end if&#13;&#10;IF (&#60;Spc.&#34;Nominal&#34;&#62;&#62;16) and (&#60;Spc.&#34;Nominal&#34;&#62;&#60;=20)  then&#13;&#10; Sh1_1max =0&#13;&#10; Sh10_1max =82            &#13;&#10; Sh100_1max =110                &#13;&#10; Sh1000_1max =132              &#13;&#10; Sh10000_1max =145            &#13;&#10; Sh1_2max =55           &#13;&#10; Sh10_2max =87            &#13;&#10; Sh100_2max =113              &#13;&#10; Sh1000_2max =135                &#13;&#10; Sh10000_2max =148    &#13;&#10;end if&#13;&#10;IF (&#60;Spc.&#34;Nominal&#34;&#62;&#62;=20.0) and (&#60;Spc.&#34;Nominal&#34;&#62;&#60;40.0)  then&#13;&#10;Sh1_1max =0&#13;&#10;Sh10_1max =75                  &#13;&#10; Sh100_1max =105                          &#13;&#10; Sh1000_1max =130                            &#13;&#10; Sh10000_1max =145            &#13;&#10; Sh1_2max =55          &#13;&#10; Sh10_2max =87              &#13;&#10; Sh100_2max =110                  &#13;&#10; Sh1000_2max =132               &#13;&#10; Sh10000_2max =148    &#13;&#10;end if&#13;&#10;IF (&#60;Spc.&#34;Nominal&#34;&#62;&#62;=40)   then&#13;&#10;Sh1_1max =0&#13;&#10;Sh10_1max =70                     &#13;&#10; Sh100_1max =102                            &#13;&#10; Sh1000_1max =120                             &#13;&#10; Sh10000_1max =137               &#13;&#10; Sh1_2max =50           &#13;&#10; Sh10_2max =80               &#13;&#10; Sh100_2max =105                    &#13;&#10; Sh1000_2max =125                    &#13;&#10; Sh10000_2max =140    &#13;&#10;end if&#13;&#10;else&#13;&#10;  &#13;&#10;end if               &#13;&#10;  PhazeNoiseShum100.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum1&#34;&#62;))&#13;&#10;  Memo3.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;))&#13;&#10;  Memo18.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;))&#13;&#10;  Memo39.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;))&#13;&#10;  Memo53.Text=FormatFloat(&#34;0.0&#34;,Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;))&#13;&#10;&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;)&#60;Sh10_1max THEN temp1=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;)&#60;Sh10_1max THEN countSh1_1=countSh1_1+1            &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;)&#60;Sh100_1max THEN temp1=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;)&#60;Sh100_1max THEN countSh2_1=countSh2_1+1            &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;)&#60;Sh1000_1max THEN temp1=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;)&#60;Sh1000_1max THEN countSh3_1=countSh3_1+1    &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;)&#60;Sh10000_1max THEN temp1=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;)&#60;Sh10000_1max THEN countSh4_1=countSh4_1+1    &#13;&#10;&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum1&#34;&#62;)&#60;Sh1_2max THEN temp2=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum1&#34;&#62;)&#60;Sh1_2max THEN countSh_2=countSh_2+1            &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;)&#60;Sh10_2max THEN temp2=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10&#34;&#62;)&#60;Sh10_2max THEN countSh1_2=countSh1_2+1    &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;)&#60;Sh100_2max THEN temp2=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum100&#34;&#62;)&#60;Sh100_2max THEN countSh2_2=countSh2_2+1    &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;)&#60;Sh1000_2max THEN temp2=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum1K&#34;&#62;)&#60;Sh1000_2max THEN countSh3_2=countSh3_2+1    &#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;)&#60;Sh10000_2max THEN temp2=1&#13;&#10;IF  Abs(&#60;PhazeNoise.&#34;Shum10K&#34;&#62;)&#60;Sh10000_2max THEN countSh4_2=countSh4_2+1    &#13;&#10;  &#13;&#10;  &#13;&#10;&#13;&#10;Memo11.Text=IntToStr(countSh1_1)&#13;&#10;Memo8.Text=IntToStr(count1-countSh1_1)&#13;&#10;Memo22.Text=IntToStr(countSh2_1)&#13;&#10;Memo21.Text=IntToStr(count1-countSh2_1)&#13;&#10;Memo48.Text=IntToStr(countSh3_1)&#13;&#10;Memo47.Text=IntToStr(count1-countSh3_1)&#13;&#10;Memo57.Text=IntToStr(countSh4_1)&#13;&#10;Memo56.Text=IntToStr(count1-countSh4_1)&#13;&#10;&#13;&#10;Memo76.Text=IntToStr(countSh_2)&#13;&#10;Memo75.Text=IntToStr(count1-countSh_2)&#13;&#10;Memo85.Text=IntToStr(countSh1_2)&#13;&#10;Memo84.Text=IntToStr(count1-countSh1_2)&#13;&#10;Memo89.Text=IntToStr(countSh2_2)&#13;&#10;Memo88.Text=IntToStr(count1-countSh2_2)&#13;&#10;Memo93.Text=IntToStr(countSh3_2)&#13;&#10;Memo92.Text=IntToStr(count1-countSh3_2)&#13;&#10;Memo97.Text=IntToStr(countSh4_2)&#13;&#10;Memo96.Text=IntToStr(count1-countSh4_2)  &#13;&#10;  &#13;&#10;IF temp1=1  Then IF temp2=1 THEN PsiDataStatus.Text=&#34;����&#34;&#13;&#10;IF temp1=1  THEN IF temp2=1 THEN countG1=countG1+1                                       &#13;&#10;IF temp2=0  THEN PsiDataStatus.Text=&#34;����� (������ 2)&#34;&#13;&#10;IF temp2=1 THEN IF temp1=0 THEN  PsiDataStatus.Text=&#34;����� (������ 1)&#34;&#13;&#10;IF temp2=1 THEN IF temp1=0 THEN  countG2=countG2+1&#13;&#10;frxDBDataset2Good.Text=IntToStr(count1-countG1)  &#13;&#10;frxDBDataset2Bad.Text=IntToStr(countG1)&#13;&#10;Memo73.Text=IntToStr(count1-countG2)  &#13;&#10;Memo72.Text=IntToStr(countG2)    &#13;&#10;&#13;&#10;  &#13;&#10;    &#13;&#10; IF temp2=1  THEN IF temp1=1 Then PhazeNoiseShum100.Color=clSilver                              &#13;&#10; IF temp1=0 Then PhazeNoiseShum100.Color=clNone&#13;&#10; IF temp2=1  THEN IF temp1=1 Then  Memo3.Color=clSilver                              &#13;&#10; IF temp1=0  Then Memo3.Color=clNone&#13;&#10; IF temp2=1  THEN IF temp1=1 Then  Memo18.Color=clSilver                              &#13;&#10; IF temp1=0  Then Memo18.Color=clNone&#13;&#10; IF temp2=1  THEN IF temp2=1 Then Memo39.Color=clSilver                              &#13;&#10; IF temp1=0  Then Memo39.Color=clNone&#13;&#10; IF temp2=1  THEN IF temp2=1 Then  Memo53.Color=clSilver&#13;&#10;   &#13;&#10; IF temp1=0  Then PhazeNoiseN.Color=clNone     &#13;&#10; IF temp2=1  THEN IF temp1=1 Then  PhazeNoiseN.Color=clSilver                              &#13;&#10; IF temp1=0  Then Memo53.Color=clNone        &#13;&#10; IF temp2=1  THEN IF temp2=1 Then  PsiDataStatus.Color=clSilver                              &#13;&#10; IF temp1=0  Then PsiDataStatus.Color=clNone     &#13;&#10;        &#13;&#10;end sub&#13;&#10;&#13;&#10;sub Page1OnBeforePrint(Sender)&#13;&#10;      Memo15.Text=FloatToStr(Sh10_1max)&#13;&#10;      Memo37.Text=FloatToStr(Sh100_1max)&#13;&#10;      Memo51.Text=FloatToStr(Sh1000_1max)&#13;&#10;      Memo60.Text=FloatToStr(Sh10000_1max)&#13;&#10;      Memo79.Text=FloatToStr(Sh1_2max)&#13;&#10;      Memo86.Text=FloatToStr(Sh10_2max)&#13;&#10;      Memo90.Text=FloatToStr(Sh100_2max)&#13;&#10;      Memo94.Text=FloatToStr(Sh1000_2max)&#13;&#10;      Memo98.Text=FloatToStr(Sh10000_2max)          &#13;&#10;end sub    &#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  " PropData="044C65667403980003546F70021008446174617365747301010C2E00000020446174615365743D225068617A654E6F6973652220446174615365744E616D653D225068617A654E6F6973652200010C2000000020446174615365743D225370632220446174615365744E616D653D22537063220000095661726961626C65730100055374796C650100">
