      <TfrxMemoView Name="Memo27" Left="151.1812" Top="684.09493" Width="166.29932" Height="30.23624" ShowHint="false" Font.Charset="1" Font.Color="0" Font.Height="-19" Font.Name="Arial" Font.Style="1" HAlign="haCenter" ParentFont="false" VAlign="vaCenter" Text="2. Надежность"/>
      <TfrxMemoView Name="Memo28" Left="18.89765" Top="714.33117" Width="729.44929" Height="90.70872" ShowHint="false" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Arial" Font.Style="0" ParentFont="false" VAlign="vaCenter" Text="2.1 Гамма процентная наработка до отказа (Т  ) резонаторов при&#13;&#10;       = 95% не менее 150000 час.&#13;&#10;2.2. Гамма процентный срок сохраняемости (Тс  ) резонаторов при&#13;&#10;     = 95% не менее 25 лет."/>
      <TfrxMemoView Name="Memo29" Left="151.1812" Top="808.81942" Width="253.22851" Height="30.23624" ShowHint="false" Font.Charset="1" Font.Color="0" Font.Height="-19" Font.Name="Arial" Font.Style="1" HAlign="haCenter" ParentFont="false" VAlign="vaCenter" Text="3. Гарантии изготовителя"/>
      <TfrxMemoView Name="Memo30" Left="15.11812" Top="839.05566" Width="729.44929" Height="90.70872" ShowHint="false" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Arial" Font.Style="0" ParentFont="false" VAlign="vaCenter" Text="Изготовитель гарантирует соответствие качества данных резонаторов требованиям ТУ 6321-041-07614320-06 при соблюдении потребителем условий и правил хранения, монтажа и эксплуатации, приведенных в паспорте и ТУ на резонаторы."/>
      <TfrxMemoView Name="Memo31" Left="147.40167" Top="1062.04793" Width="291.02381" Height="30.23624" ShowHint="false" Font.Charset="1" Font.Color="0" Font.Height="-19" Font.Name="Arial" Font.Style="1" HAlign="haCenter" ParentFont="false" VAlign="vaCenter" Text="4. Указания по эксплуатации"/>
      <TfrxPictureView Name="Picture3" Left="37.7953" Top="1114.96135" Width="94.48825" Height="79.37013" ShowHint="false" Picture.PropData="" HightQuality="false" Transparent="false" TransparentColor="16777215"/>
