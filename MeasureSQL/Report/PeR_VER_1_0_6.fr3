<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="43382.5109326505" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended                                          &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;    &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#62;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#34;+&#34;+FloatToStr(&#60;Lianoz.&#34;Ftgk&#34;&#62;)      &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#60;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#60;Lianoz.&#34;Ftgk&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rtgk&#34;&#62;=&#34;True&#34; THEN IF &#60;Lianoz.&#34;Rtgk&#34;&#62;&#60;&#62;0 Then IF &#60;Lianoz.&#34;Rtgk&#34;&#62;&#60;10000  THEN Memo55.Text=&#60;Lianoz.&#34;Rtgk&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rtgk&#34;&#62;=&#34;False&#34; THEN Memo55.Text=FormatFloat(&#34;0.0&#34;,StrToFloat(&#60;Lianoz.&#34;R&#34;&#62;))      &#13;&#10;    &#13;&#10;end sub  &#13;&#10;&#13;&#10;sub ColumnHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Ftgk&#34;&#62;=&#34;True&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFtgk&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRtgk&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRtgk&#34;&#62;)/100   &#13;&#10;&#13;&#10;  &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo42.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#60;0 THEN Memo42.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#62;0 THEN Memo43.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo43.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))      &#13;&#10;&#13;&#10;                                  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo61.Text=FormatFloat(&#34;0.0&#34;,Rmax)  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo60.Text=FormatFloat(&#34;0,0&#34;,Rmin)&#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo56.Text=&#34;+&#34;+FloatToStr(Round(Fmax))&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo57.Text=&#34;-&#34;+FloatToStr(Round(Fmax))    &#13;&#10;    &#13;&#10;end sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Lianoz.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo51.Text=&#34;���&#34;  &#13;&#10;IF &#60;Spc.&#34;PrintProfile&#34;&#62;=41 Then Memo54.Text=&#34;�� 070.052&#34;                                                                                    &#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
