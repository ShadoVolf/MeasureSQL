<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40814.6468722801" ReportOptions.Description.Text="" ReportOptions.LastChange="42879.5581647569" ScriptLanguage="BasicScript" ScriptText.Text="&#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;      &#13;&#10;end sub  &#13;&#10;sub DetailData1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;TCHType&#34;&#62;=&#34;ïî çàìåðó&#34; THEN                                                                      &#13;&#10;   IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Physical&#34; THEN  psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;   IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Physical&#34; THEN  Memo15.Text=FormatFloat(&#34;0.0&#34;,&#60;PsiData.&#34;Nominal&#34;&#62;*1000-StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)*&#60;PsiData.&#34;Nominal&#34;&#62;)                  &#13;&#10;    IF  &#60;Spc.&#34;LoadType&#34;&#62;=&#34;EqReact&#34;  THEN  psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;   IF  &#60;Spc.&#34;LoadType&#34;&#62;=&#34;EqReact&#34;  THEN  Memo15.Text=FormatFloat(&#34;0.0&#34;,&#60;PsiData.&#34;Nominal&#34;&#62;*1000-StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)*&#60;PsiData.&#34;Nominal&#34;&#62;)            &#13;&#10;   IF  &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Series&#34; THEN psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;   IF  &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Series&#34; THEN Memo15.Text=FormatFloat(&#34;0.0&#34;,&#60;PsiData.&#34;Nominal&#34;&#62;*1000-StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)*&#60;PsiData.&#34;Nominal&#34;&#62;)                                                               &#13;&#10;       &#13;&#10;   END IF&#13;&#10;IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;Fs(Fr)&#34;   THEN&#13;&#10;       psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;        Memo15.Text=FormatFloat(&#34;0.0&#34;,&#60;PsiData.&#34;Nominal&#34;&#62;*1000-StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)*&#60;PsiData.&#34;Nominal&#34;&#62;)             &#13;&#10; END IF&#13;&#10;&#13;&#10;   &#13;&#10;   &#13;&#10;IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;FL&#34;   THEN&#13;&#10;       psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;      Memo15.Text=FormatFloat(&#34;0.0&#34;,&#60;PsiData.&#34;Nominal&#34;&#62;*1000-StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)*&#60;PsiData.&#34;Nominal&#34;&#62;)             &#13;&#10; END IF    &#13;&#10;&#13;&#10;     &#13;&#10; IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;FL0&#34;   THEN&#13;&#10;     psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;      Memo15.Text=FormatFloat(&#34;0.0&#34;,&#60;PsiData.&#34;Nominal&#34;&#62;*1000-StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)*&#60;PsiData.&#34;Nominal&#34;&#62;)           &#13;&#10; END IF&#13;&#10;  &#13;&#10;IF &#60;psiDataTemp.&#34;Temp&#34;&#62;&#60;=60  THEN&#13;&#10;   IF &#60;psiDataTemp.&#34;variant_1&#34;&#62;=1 THEN  Memo12.Text=&#34;1&#34;&#13;&#10;   IF &#60;psiDataTemp.&#34;variant_1&#34;&#62;=0 THEN  Memo12.Text=&#34;0&#34;       &#13;&#10;   IF &#60;psiDataTemp.&#34;variant_2&#34;&#62;=1 THEN  Memo13.Text=&#34;1&#34;&#13;&#10;   IF &#60;psiDataTemp.&#34;variant_2&#34;&#62;=0 THEN  Memo13.Text=&#34;0&#34;&#13;&#10;   IF &#60;psiDataTemp.&#34;variant_3&#34;&#62;=1 THEN  Memo14.Text=&#34;1&#34;&#13;&#10;   IF &#60;psiDataTemp.&#34;variant_3&#34;&#62;=0 THEN  Memo14.Text=&#34;0&#34;       &#13;&#10;   END IF&#13;&#10;    IF &#60;psiDataTemp.&#34;Temp&#34;&#62;=20  THEN&#13;&#10;     Memo12.Text=&#34;1&#34;&#13;&#10;         &#13;&#10;    Memo13.Text=&#34;1&#34;&#13;&#10; &#13;&#10;    Memo14.Text=&#34;1&#34;&#13;&#10;          &#13;&#10;   END IF       &#13;&#10; IF &#60;psiDataTemp.&#34;Temp&#34;&#62;&#62;60  THEN&#13;&#10;   Memo12.Text=&#34;&#34;       &#13;&#10;   Memo13.Text=&#34;&#34;   &#13;&#10;   Memo14.Text=&#34;&#34;       &#13;&#10;   END IF&#13;&#10;       &#13;&#10;       &#13;&#10;end sub &#13;&#10;sub Footer1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;  IF &#60;PsiData.&#34;Variant_1&#34;&#62;=&#34;True&#34; THEN Memo19.Text=&#34;À&#34;&#13;&#10;  IF &#60;PsiData.&#34;Variant_2&#34;&#62;=&#34;True&#34; THEN Memo20.Text=&#34;Á&#34;&#13;&#10;  IF &#60;PsiData.&#34;Variant_2&#34;&#62;=&#34;True&#34; THEN Memo21.Text=&#34;Ã&#34;      &#13;&#10;end sub&#13;&#10;&#13;&#10;     " PropData="">
