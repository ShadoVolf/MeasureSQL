mp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;      IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Saunders(FL)&#34;  THEN  psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))         &#13;&#10;   IF  &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Series&#34; THEN psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;   IF  &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Saunders(FR)&#34; THEN psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))&#13;&#10;   END IF&#13;&#10;IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;Fs(Fr)&#34;   THEN&#13;&#10;       psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;F&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))  &#13;&#10; END IF&#13;&#10; IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;FL&#34;   THEN&#13;&#10;     psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))  &#13;&#10; END IF&#13;&#10; IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;FL0&#34;   THEN&#13;&#10;     psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))  &#13;&#10; END IF     &#13;&#10;end sub &#13;&#10;     " PropData="">
