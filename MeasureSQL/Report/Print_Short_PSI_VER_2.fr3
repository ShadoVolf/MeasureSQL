34;Fn&#34;&#62;))  &#13;&#10; END IF&#13;&#10; IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;FL&#34;   THEN&#13;&#10;     psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))  &#13;&#10; END IF&#13;&#10; IF  &#60;Spc.&#34;TCHType&#34;&#62;=&#34;FL0&#34;   THEN&#13;&#10;     psiDataTempF.Text=FormatFloat(&#34;0.00&#34;,(StrToFloat(&#60;psiDataTemp.&#34;FL&#34;&#62;)-&#60;PsiData.&#34;Fn&#34;&#62;))  &#13;&#10; END IF  &#13;&#10;&#13;&#10;end sub &#13;&#10; &#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;     IF &#60;PsiData.&#34;PoverKa&#34;&#62;=&#34;True&#34; Then&#13;&#10;     Memo22.Text=&#34;�������&#34;&#13;&#10;  END IF&#13;&#10;  IF &#60;PsiData.&#34;PoverKa&#34;&#62;=&#34;False&#34; Then      &#13;&#10;    Memo22.Text=&#34;����������&#34;         &#13;&#10;  END IF  &#13;&#10;  IF &#60;PsiData.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo18.Text=&#34;���&#34;  &#13;&#10;end sub     " PropData="">
