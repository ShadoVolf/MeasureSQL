<TfrxReport Version="4.9" DataSetName="frxUserDataSet1" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39953.7254732639" ReportOptions.Description.Text="" ReportOptions.LastChange="41729.6617745486" ScriptLanguage="BasicScript" ScriptText.Text="Dim count1 As Integer&#13;&#10;Dim countR1 As Integer&#13;&#10;Dim countR2 AS Integer&#13;&#10;Dim countRavg As Integer    &#13;&#10;Dim temp As Integer  &#13;&#10;Dim countBad As Integer    &#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;    &#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;    IF &#60;PsiData.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo23.Text=&#34;���&#34;&#13;&#10;  IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Saunders (FR+FL)&#34; THEN Memo52.Text=&#34;EqReact&#34;&#13;&#10;  IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Saunders(FR)&#34; THEN Memo52.Text=&#34;Series&#34;&#13;&#10;  IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Saunders(FL)&#34; THEN Memo52.Text=&#34;Physical&#34;&#13;&#10;  IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;EqReact&#34; THEN Memo52.Text=&#34;EqReact&#34;&#13;&#10;  IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Series&#34; THEN Memo52.Text=&#34;Series&#34;&#13;&#10;  IF &#60;Spc.&#34;LoadType&#34;&#62;=&#34;Physical&#34; THEN Memo52.Text=&#34;Physical&#34;  &#13;&#10;  end sub&#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;    &#13;&#10;count1=count1+1&#13;&#10;temp=0  &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;RsphereMax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;RsphereMin&#34;&#62;)&#13;&#10;&#13;&#10;&#13;&#10;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo50.Text=FloatToStr(Rmax)&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo51.Text=FloatToStr(Rmin)    &#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo57.Text=FloatToStr(Rmax)&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo58.Text=FloatToStr(Rmin)&#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo59.Text=FloatToStr(Rmax)&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo84.Text=FloatToStr(Rmin)    &#13;&#10;      &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;RSphere1&#34;&#62;&#62;  Rmax Then countR1=countR1+1&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;RSphere1&#34;&#62;&#60;  Rmin Then countR1=countR1+1    &#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;RSphere2&#34;&#62;&#62;  Rmax Then countR2=countR2+1&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;RSphere2&#34;&#62;&#60;  Rmin Then countR2=countR2+1&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF (&#60;PsiData.&#34;RSphere1&#34;&#62;+&#60;PsiData.&#34;RSphere2&#34;&#62;)/2&#62;  Rmax Then countRavg=countRavg+1&#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF (&#60;PsiData.&#34;RSphere1&#34;&#62;+&#60;PsiData.&#34;RSphere2&#34;&#62;)/2&#60;  Rmin Then countRavg=countRavg+1&#13;&#10;IF &#60;Spc.&#34;RsphereMax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF (&#60;PsiData.&#34;RSphere1&#34;&#62;+&#60;PsiData.&#34;RSphere2&#34;&#62;)/2&#62;  Rmax Then temp=1             &#13;&#10;IF &#60;Spc.&#34;RsphereMin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF (&#60;PsiData.&#34;RSphere1&#34;&#62;+&#60;PsiData.&#34;RSphere2&#34;&#62;)/2&#60;  Rmin Then temp=1&#13;&#10;                  &#13;&#10;    &#13;&#10;Memo77.Text=IntToStr(countR1)&#13;&#10;Memo76.Text=IntToStr(count1-countR1)&#13;&#10;Memo63.Text=IntToStr(countR2)&#13;&#10;Memo61.Text=IntToStr(count1-countR2)&#13;&#10;Memo79.Text=IntToStr(countRavg)&#13;&#10;Memo78.Text=IntToStr(count1-countRavg)  &#13;&#10;IF temp=1 THEN PsiDataStatus.Text=&#34;����&#34;&#13;&#10;IF temp=0 THEN PsiDataStatus.Text=&#34;�����&#34;      &#13;&#10;IF &#60;PsiData.&#34;Status&#34;&#62;=&#34;������.&#34; THEN PsiDataStatus.Text=&#34;������.&#34;             &#13;&#10;IF &#60;PsiData.&#34;Status2&#34;&#62;=&#34;BAD&#34; THEN PsiDataStatus.Text=&#34;�������&#34;&#13;&#10;IF &#60;PsiData.&#34;Status2&#34;&#62;=&#34;BAD&#34; THEN temp=1    &#13;&#10;IF temp=1 Then countBad=countBad+1                                &#13;&#10;frxDBDataset2Good.Text=IntToStr(count1-countBad)&#13;&#10;Memo6.Text=IntToStr(countBad)        &#13;&#10;IF &#60;PsiData.&#34;Status&#34;&#62;=&#34;������.&#34; THEN temp=1    &#13;&#10;IF temp=1 Then PsiDataFSpur1.Color=clSilver                              &#13;&#10;IF temp=0 Then PsiDataFSpur1.Color=clNone                &#13;&#10;IF temp=1 Then PsiDataPosition.Color=clSilver     &#13;&#10;IF temp=0 Then PsiDataPosition.Color=clNone    &#13;&#10;IF temp=1 Then PsiDataN.Color=clSilver     &#13;&#10;IF temp=0 Then PsiDataN.Color=clNone    &#13;&#10;IF temp=1 Then PsiDataFSpur2.Color=clSilver     &#13;&#10;IF temp=0 Then PsiDataFSpur2.Color=clNone    &#13;&#10;IF temp=1 Then PsiDataRSphere1.Color=clSilver     &#13;&#10;IF temp=0 Then PsiDataRSphere1.Color=clNone    &#13;&#10;IF temp=1 Then PsiDataRSphere2.Color=clSilver     &#13;&#10;IF temp=0 Then PsiDataRSphere2.Color=clNone&#13;&#10;IF temp=1 Then Memo22.Color=clSilver     &#13;&#10;IF temp=0 Then Memo22.Color=clNone    &#13;&#10;&#13;&#10;end sub  " PropData="">
