<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="45672.4837895718" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended    &#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended                                          &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;    &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#62;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#34;+&#34;+FloatToStr(&#60;Lianoz.&#34;Ftgk&#34;&#62;)      &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#60;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#60;Lianoz.&#34;Ftgk&#34;&#62;    &#13;&#10;IF StrToFloat(&#60;Spc.&#34;Nominal&#34;&#62;)&#60;=30 THEN IF StrToFloat(&#60;Lianoz.&#34;Rtgk&#34;&#62;)&#60;&#62;0 Then IF &#60;Lianoz.&#34;Rtgk&#34;&#62;&#60;10000 THEN Memo55.Text=FloatToStr(Round(StrToFloat(&#60;Lianoz.&#34;Rtgk&#34;&#62;)*10)/10)                &#13;&#10;IF StrToFloat(&#60;Spc.&#34;Nominal&#34;&#62;)&#62;30 THEN IF StrToFloat(&#60;Lianoz.&#34;R&#34;&#62;)&#60;&#62;0 Then IF &#60;Lianoz.&#34;R&#34;&#62;&#60;10000 THEN Memo55.Text=FloatToStr(Round(StrToFloat(&#60;Lianoz.&#34;R&#34;&#62;)*10)/10)&#13;&#10;IF Abs(StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;))&#62;=Abs(StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;)) THEN LianozFmaxm.Text=FormatFloat(&#34;0.0&#34;,StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;))  &#13;&#10;IF Abs(StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;))&#60;Abs(StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;)) THEN LianozFmaxm.Text=FormatFloat(&#34;0.0&#34;,StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;))    &#13;&#10;end sub  &#13;&#10;&#13;&#10;sub ColumnHeader1OnBeforePrint(Sender)&#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo25.Text=&#60;Spc.&#34;RR2max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo61.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo60.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo58.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo58.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo59.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo59.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo56.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#60;0 THEN Memo56.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#62;0 THEN Memo57.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo57.Text=&#34;-&#34;+FloatT