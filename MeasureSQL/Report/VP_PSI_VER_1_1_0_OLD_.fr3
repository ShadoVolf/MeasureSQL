<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="46321.5617382292" ScriptLanguage="BasicScript" ScriptText.Text="Dim S As String&#13;&#10;Dim LN1 As Integer    &#13;&#10;Dim Subs As String  &#13;&#10;&#13;&#10;&#13;&#10;      &#13;&#10;    &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;S=&#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;Subs=Copy(S,0,1)&#13;&#10;LN1=Length(S)                            &#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;LN1=Length(S)    &#13;&#10;Subs=Copy(S,0,1)&#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;frxDBDataset1N.Text=S    &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#62;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo25.Text=&#34;+&#34;+FloatToStr(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#60;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo25.Text=&#60;Lianoz.&#34;Ftgk&#34;&#62;             &#13;&#10;  &#13;&#10;end sub&#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;   dim dat as String                      &#13;&#10;        dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)                                          &#13;&#10;        BarCode1.Expression=dat&#13;&#10;        BarCode2.Expression=dat            &#13;&#10;end sub  &#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Ftgk&#34;&#62;=&#34;True&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;)      &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo42.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo43.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0_C1max&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo52.Text=&#60;Spc.&#34;C0_C1max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0_C1min&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo53.Text=&#60;Spc.&#34;C0_C1min&#34;&#62;                  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;                   &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo48.Text=&#60;Spc.&#34;C0max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo49.Text=&#60;Spc.&#34;C0min&#34;&#62;                   &#13;&#10; IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo46.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo47.Text=&#60;Spc.&#34;Rmaxmin&#34;&#62;&#13;&#10;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo14.Text=&#34;+&#34;+FloatToStr(Round(Fmax))  &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo15.Text=&#34;-&#34;+FloatToStr(Round(Fmax))    &#13;&#10;end sub&#13;&#10;&#13;&#10;  " PropData="">
