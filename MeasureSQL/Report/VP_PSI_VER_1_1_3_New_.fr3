<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="46337.7469326968" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Smax As Extended&#13;&#10;Dim Smin As Extended&#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim C0_C1max As Extended&#13;&#10;Dim C0_C1min As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended           &#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended    &#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;Dim S As String&#13;&#10;Dim LN1 As Integer    &#13;&#10;Dim Subs As String&#13;&#10;&#13;&#10;&#13;&#10;Dim Numbers_line as String                                                                        &#13;&#10;Dim count_ as Integer&#13;&#10;count_ =0&#13;&#10;Numbers_line = &#34; &#34;&#13;&#10;  &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;S=&#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;Subs=Copy(S,0,1)&#13;&#10;LN1=Length(S)                            &#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;LN1=Length(S)    &#13;&#10;Subs=Copy(S,0,1)&#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;Memo48.Text=S  &#13;&#10;      count_ = count_ + 1&#13;&#10;&#13;&#10;    IF count_ = 1 THEN&#13;&#10;        Numbers_line = &#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;    ELSE&#13;&#10;        Numbers_line = Numbers_line + &#34;, &#34; + &#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;    END IF&#13;&#10;&#13;&#10;    IF count_ &#60;= 10 THEN&#13;&#10;        Memo49.Text = Numbers_line&#13;&#10;    ELSE&#13;&#10;        Memo49.Text = &#34;� ���������� &#34; + FloatToStr(count_) + &#34; ��&#34;&#13;&#10;    END IF    &#13;&#10;end sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;      &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo30.Text=&#60;Spc.&#34;Rsp1min&#34;&#62;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo45.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo44.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;RR4max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo55.Text=&#60;Spc.&#34;RR4max&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;RR4min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo64.Text=&#60;Spc.&#34;RR4min&#34;&#62;    &#13;&#10;    &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo42.Text=&#60;Spc.&#34;Fmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo43.Text=(&#60;Spc.&#34;Fmin&#34;&#62;)    &#13;&#10;&#13;&#10;end sub&#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;  dim dat as String                      &#13;&#10;        dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)                                     