<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="41516.5948298148" ScriptLanguage="BasicScript" ScriptText.Text="    &#13;&#10;&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Lmax As Extended&#13;&#10;Dim Lmin As Extended    &#13;&#10;Dim Mmax As Extended&#13;&#10;Dim Mmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended&#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended&#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended    &#13;&#10;    &#13;&#10;sub MasterData1OnBeforePrint(Sender)                &#13;&#10;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmax=StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmin=StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;)    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmax=StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmin=StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62; &#60;&#62;&#34;no&#34; Then RRmax=StrToFloat(&#60;Spc.&#34;RR2max&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;RR2max&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100                     &#13;&#10;IF &#60;Spc.&#34;RR2min&#34;&#62; &#60;&#62;&#34;no&#34; Then RRmin=StrToFloat(&#60;Spc.&#34;RR2min&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;RR2min&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100      &#13;&#10;&#13;&#10;              &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo42.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo43.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo29.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo38.Text=&#60;Spc.&#34;Rmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo46.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo47.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;                   &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo52.Text=&#60;Spc.&#34;Mmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo53.Text=&#60;Spc.&#34;Mmin&#34;&#62;                   &#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo48.Text=&#60;Spc.&#34;Fminmax&#34;&#62;            &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo49.Text=&#60;Spc.&#34;Fminmin&#34;&#62;                   &#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo50.Text=&#60;Spc.&#34;RR2max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;RR2min&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo51.Text=&#60;Spc.&#34;RR2min&#34;&#62;  &#13;&#10;    &#13;&#10;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo30.Text=FloatToStr(Fmaxmax)&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo31.Text=FloatToStr(Fmaxmin)         &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo33.Text=FloatToStr(Fminmin)&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo32.Text=FloatToStr(Fminmax)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo37.Text=FloatToStr(Mmin)&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo36.Text=FloatToStr(Mmax)&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo27.Text=FloatToStr(Rmin)&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo26.Text=FloatToStr(Rmax)&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo28.Text=FloatToStr(Rmaxmin)&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo13.Text=FloatToStr(Rmaxmax)    &#13;&#10;IF &#60;Spc.&#34;RR2min&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo35.Text=FloatToStr(RRmin)&#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo34.Text=FloatToStr(RRmax)&#13;&#10;  &#13;&#10;    &#13;&#10;    &#13;&#10;sub Label1OnClick(Sender)&#13;&#10;&#13;&#10;&#13;&#10;end sub&#13;&#10;&#13;&#10;end sub" PropData="">
