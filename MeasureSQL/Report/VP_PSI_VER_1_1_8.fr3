<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="42129.5906565509" ScriptLanguage="BasicScript" ScriptText.Text="Dim countf As Longint                                                               &#13;&#10;Dim count1 As Integer&#13;&#10;Dim countR As Integer&#13;&#10;Dim countQ AS Integer&#13;&#10;Dim countTmax As Integer&#13;&#10;Dim countC0 As Integer&#13;&#10;Dim countCq As Integer&#13;&#10;Dim countRcRb As Integer    &#13;&#10;Dim temp1 As Integer  &#13;&#10;Dim countBad As Integer    &#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Qmax As Extended&#13;&#10;Dim Qmin As Extended    &#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim Tmaxmax As Extended&#13;&#10;Dim Tmaxmin As Extended&#13;&#10;Dim RcRbmax As Extended    &#13;&#10;&#13;&#10;  &#13;&#10;sub MasterData1OnBeforePrint(Sender)    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo42.Text=&#60;Spc.&#34;Fmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo43.Text=&#60;Spc.&#34;Fmin&#34;&#62;              &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo44.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo45.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo46.Text=&#60;Spc.&#34;Qmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo47.Text=&#60;Spc.&#34;Qmin&#34;&#62;                  &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo52.Tex