<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="41689.5845918287" ScriptLanguage="BasicScript" ScriptText.Text="    &#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended    &#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim Mmax As Extended&#13;&#10;Dim Mmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended&#13;&#10;Dim FTmax As Extended&#13;&#10;Dim FTmin As Extended&#13;&#10;Dim Ft1max As Extended&#13;&#10;Dim Ft1min As Extended&#13;&#10;Dim Ft2max As Extended&#13;&#10;Dim Ft2min As Extended&#13;&#10;Dim RR2max As Extended&#13;&#10;Dim RR2min As Extended    &#13;&#10;    &#13;&#10;sub MasterData1OnBeforePrint(Sender)                &#13;&#10;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;Dop