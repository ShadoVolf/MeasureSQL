<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="45226.6675332986" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended           &#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended    &#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended &#13;&#10;Dim RRmax As Extended&#13;&#10;&#13;&#10;Dim S As String&#13;&#10;Dim LN1 As Integer    &#13;&#10;Dim Subs As String    &#13;&#10;&#13;&#10;      &#13;&#10;sub PageHeader1OnBeforePrint(Sender)  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo45.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo44.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo26.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;    &#13;&#10;  &#13;&#10;end sub&#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)         &#13;&#10;  dim dat as String                      &#13;&#10;        dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)                                          &#13;&#10;        BarCode2.Expression=dat&#13;&#10;        IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo45.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo44.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo26.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;            &#13;&#10;end sub&#13;&#10;&#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;    IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo45.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo44.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo26.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;  &#13;&#10;&#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
