<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="46065.504363044" ScriptLanguage="BasicScript" ScriptText.Text="Dim countf As Longint                                                               &#13;&#10;Dim count1 As Integer&#13;&#10;Dim countR As Integer&#13;&#10;Dim countQ AS Integer&#13;&#10;Dim countRR As Integer    &#13;&#10;Dim countRcRb As Integer&#13;&#10;Dim countTmax As Integer    &#13;&#10;Dim countC0 As Integer&#13;&#10;Dim countCq As Integer&#13;&#10;Dim temp1 As Integer  &#13;&#10;Dim countBad As Integer    &#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Qmax As Extended&#13;&#10;Dim Qmin As Extended    &#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim Tmaxmax As Extended&#13;&#10;Dim Tmaxmin As Extended&#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended    &#13;&#10;Dim RcRbmax As Extended&#13;&#10;    &#13;&#10;  &#13;&#10;sub ReportTitle1OnAfterPrint(Sender)&#13;&#10;  &#13;&#10;dim dat as String                      &#13;&#10;dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)&#13;&#10;BarCode1.Expression=dat&#13;&#10;&#13;&#10;end sub  &#13;&#10;  &#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo80.Text=&#60;Spc.&#34;Fmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo81.Text=&#60;Spc.&#34;Fmin&#34;&#62;              &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo82.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo118.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo125.Text=&#60;Spc.&#34;Qmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo126.Text=&#60;Spc.&#34;Qmin&#34;&#62;                  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo127.Text=FloatToStr(Round(StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)*100)/100)                      &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo128.Text=FloatToStr(Round(StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)*100)/100)                                             &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo129.Text=FloatToStr(Round(StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)*1000)/1000)                                      &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo130.Text=FloatToStr(Round(StrToFLoat(&#60;Spc.&#34;Cqmin&#34;&#62;)*1000)/1000)                          &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo160.Text=&#60;Spc.&#34;Tmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo161.Text=&#60;Spc.&#34;Tmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo156.Text=&#60;Spc.&#34;Rc_Rbmax&#34;&#62;  &#13;&#10;&#13;&#10;end sub  &#13;&#10;  &#13;&#10;sub MasterData2OnBeforePrint(Sender)&#13;&#10;count1=count1+1    &#13;&#10;temp1=0&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)   &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)    &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmax=StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmin=StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;) &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)  &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Tmaxmax=StrToFloat(&#60;Spc.&#34;Tmaxmax&#34;&#62;)  &#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Tmaxmin=StrToFloat(&#60;Spc.&#34;Tmaxmin&#34;&#62;)    &#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then RcRbmax=StrToFloat(&#60;Spc.&#34;Rc_Rbmax&#34;&#62;)      &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo106.Text=FloatToStr(Tmaxmax)&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo117.Text=FloatToStr(Tmaxmin)    &#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo108.Text=FloatToStr(Qmin)&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo107.Text=FloatToStr(Qmax)&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo114.Text=FloatToStr(C0min)&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo113.Text=FloatToStr(C0max)&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo116.Text=FloatToStr(Cqmin)&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo115.Text=FloatToStr(Cqmax)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo98.Text=FloatToStr(Fmin)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo97.Text=FloatToStr(Fmax)&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo100.Text=FloatToStr(Round(Rmin))  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo99.Text=FloatToStr(Round(Rmax))  &#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo111.Text=FloatToStr(RcRbmax)  &#13;&#10;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; Fmax Then countf=countf+1&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;F&#34;&#62;&#60;  Fmin Then countf=countf+1&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; Fmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;F&#34;&#62;&#60;  Fmin Then temp1=1              &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62;  Rmax Then countR=countR+1&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60;  Rmin Then countR=countR+1&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#62;  Rmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;R&#34;&#62;&#60;  Rmin Then temp1=1                 &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#62; Qmax Then countQ=countQ+1&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#60; Qmin Then countQ=countQ+1&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#62; Qmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#60; Qmin Then temp1=1&#13;&#10;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;RcRb&#34;&#62;&#62; RcRbmax Then countRcRb=countRcRb+1  &#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;RcRb&#34;&#62;&#62; RcRbmax Then temp1=1             &#13;&#10;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Tmax&#34;&#62;&#62; Tmaxmax Then countTmax=countTmax+1&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Tmax&#34;&#62;&#60; Tmaxmin Then countTmax=countTmax+1&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Tmax&#34;&#62;&#62; Tmaxmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Tmax&#34;&#62;&#60; Tmaxmin Then temp1=1    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; C0max Then countC0=countC0+1&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; C0min Then countC0=countC0+1&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; C0max Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; C0min Then temp1=1&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; Cqmax Then countCq=countCq+1            &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; Cqmin Then countCq=countCq+1&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; Cqmax Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; Cqmin Then temp1=1                 &#13;&#10;              &#13;&#10;    &#13;&#10;Memo73.Text=IntToStr(countf)&#13;&#10;Memo72.Text=IntToStr(count1-countf)&#13;&#10;Memo75.Text=IntToStr(countR)&#13;&#10;Memo74.Text=IntToStr(count1-countR)&#13;&#10;Memo77.Text=IntToStr(countQ)&#13;&#10;Memo76.Text=IntToStr(count1-countQ)    &#13;&#10;Memo87.Text=IntToStr(countC0)&#13;&#10;Memo86.Text=IntToStr(count1-countC0)&#13;&#10;Memo89.Text=IntToStr(countCq)&#13;&#10;Memo88.Text=IntToStr(count1-countCq)&#13;&#10;Memo105.Text=IntToStr(countTmax)&#13;&#10;Memo104.Text=IntToStr(count1-countTmax)    &#13;&#10;Memo79.Text=IntToStr(countRcRb)&#13;&#10;Memo78.Text=IntToStr(count1-countRcRb)  &#13;&#10;&#13;&#10;IF temp1=1 Then  PsiDataStatus.Text=&#34;����&#34;&#13;&#10;IF temp1=0 THEN PsiDataStatus.Text=&#34;�����&#34;&#13;&#10;                   &#13;&#10;IF &#60;PsiData.&#34;Status2&#34;&#62;=&#34;BAD&#34; THEN PsiDataStatus.Text=&#34;�������&#34;&#13;&#10;IF &#60;PsiData.&#34;Status2&#34;&#62;=&#34;BAD&#34; THEN temp1=1&#13;&#10;    &#13;&#10;IF temp1=1 Then countBad=countBad+1&#13;&#10;                                &#13;&#10;frxDBDataset2Good.Text=IntToStr(count1-countBad)&#13;&#10;frxDBDataset2Bad.Text=IntToStr(countBad)    &#13;&#10;&#13;&#10;  &#13;&#10;IF temp1=1 Then PsiDataF.Color=clSilver                              &#13;&#10;IF temp1=0 Then  PsiDataF.Color=clNone&#13;&#10;                &#13;&#10;IF temp1=1 Then  PsiDataPosition.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataPosition.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataN.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataN.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataR.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataR.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataQ.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataQ.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataC0.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataC0.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataCq.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataCq.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataStatus.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataStatus.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1 Then  PsiDataRcRb.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataRcRb.Color=clNone    &#13;&#10;  &#13;&#10;IF temp1=1 Then  PsiDataTmax.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataTmax.Color=clNone  &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;end sub" PropData="">
