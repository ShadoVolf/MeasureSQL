#62;&#62; Mmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Mono&#34;&#62;&#60; Mmin Then temp1=1    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; C0max Then countC0=countC0+1&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; C0min Then countC0=countC0+1&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#62; C0max Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;C0&#34;&#62;&#60; C0min Then temp1=1&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; Cqmax Then countCq=countCq+1            &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; Cqmin Then countCq=countCq+1&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#62; Cqmax Then temp1=1                         &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Cq&#34;&#62;&#60; Cqmin Then temp1=1                 &#13;&#10;              &#13;&#10;    &#13;&#10;Memo89.Text=IntToStr(countf)&#13;&#10;Memo88.Text=IntToStr(count1-countf)&#13;&#10;Memo93.Text=IntToStr(countR)&#13;&#10;Memo92.Text=IntToStr(count1-countR)&#13;&#10;Memo126.Text=IntToStr(countM)&#13;&#10;Memo125.Text=IntToStr(count1-countM)&#13;&#10;Memo121.Text=IntToStr(countFptp)&#13;&#10;Memo120.Text=IntToStr(count1-countFptp)    &#13;&#10;Memo99.Text=IntToStr(countC0)&#13;&#10;Memo98.Text=IntToStr(count1-countC0)&#13;&#10;Memo101.Text=IntToStr(countCq)&#13;&#10;Memo100.Text=IntToStr(count1-countCq)  &#13;&#10;&#13;&#10;IF temp1=1 Then  PsiDataStatus.Text=&#34;����&#34;&#13;&#10;IF temp1=0 THEN PsiDataStatus.Text=&#34;�����&#34;&#13;&#10;                   &#13;&#10;IF &#60;PsiData.&#34;Status2&#34;&#62;=&#34;BAD&#34; THEN PsiDataStatus.Text=&#34;�������&#34;&#13;&#10;IF &#60;PsiData.&#34;Status2&#34;&#62;=&#34;BAD&#34; THEN temp1=1&#13;&#10;    &#13;&#10;IF temp1=1 Then countBad=countBad+1&#13;&#10;                                &#13;&#10;frxDBDataset2Good.Text=IntToStr(count1-countBad)&#13;&#10;frxDBDataset2Bad.Text=IntToStr(countBad)    &#13;&#10;&#13;&#10;  &#13;&#10;IF temp1=1 Then PsiDataF.Color=clSilver                              &#13;&#10;IF temp1=0 Then  PsiDataF.Color=clNone&#13;&#10;                &#13;&#10;IF temp1=1 Then  PsiDataPosition.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataPosition.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataN.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataN.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataR.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataR.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataMono.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataMono.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataC0.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataC0.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataCq.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataCq.Color=clNone&#13;&#10;    &#13;&#10;IF temp1=1 Then  PsiDataStatus.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataStatus.Color=clNone&#13;&#10;&#13;&#10;IF temp1=1 Then  PsiDataFptp.Color=clSilver     &#13;&#10;IF temp1=0 Then  PsiDataFptp.Color=clNone&#13;&#10;  &#13;&#10;&#13;&#10;end sub&#13;&#10;&#13;&#10;  " PropData="">
