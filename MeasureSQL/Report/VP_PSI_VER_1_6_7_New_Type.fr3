4;no&#34; Then    Memo99.Text=FloatToStr(Round(Rmaxmax))    &#13;&#10;IF &#60;Spc.&#34;FTmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo110.Text=FloatToStr(FTmin)  &#13;&#10;IF &#60;Spc.&#34;FTmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo109.Text=FloatToStr(FTmax)  &#13;&#10;  &#13;&#10;&#13;&#10;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; Fmax Then countf=countf+1&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;F&#34;&#62;&#60;  Fmin Then countf=countf+1&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  IF &#60;PsiData.&#34;F&#34;&#62;&#62; Fmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;F&#34;&#62;&#60;  Fmin Then temp1=1              &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#62;  Rmaxmax Then countR=countR+1&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#60;  Rmaxmin Then countR=countR+1&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#62;  Rmaxmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Rmax&#34;&#62;&#60;  Rmaxmin Then temp1=1&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#62; Qmax Then countQ=countQ+1&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#60; Qmin Then countQ=countQ+1&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#62; Qmax Then temp1=1             &#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then IF &#60;PsiData.&#34;Q&#34;&#62;&#60; Qmin Then temp1=1&#13;&#10;  &#13;&#10;&#13;&#10;  &#1