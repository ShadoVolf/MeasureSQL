<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="45587.4433545833" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Smax As Extended&#13;&#10;Dim Smin As Extended&#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim C0_C1max As Extended&#13;&#10;Dim C0_C1min As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended           &#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended    &#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;Dim S As String&#13;&#10;Dim LN1 As Integer    &#13;&#10;Dim Subs As String    &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;S=&#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;Subs=Copy(S,0,1)&#13;&#10;LN1=Length(S)                            &#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;LN1=Length(S)    &#13;&#10;Subs=Copy(S,0,1)&#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;Memo48.Text=S                            &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#62;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#34;+&#34;+FloatToStr(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#60;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#60;Lianoz.&#34;Ftgk&#34;&#62;    &#13;&#10;IF StrToFloat(&#60;Spc.&#34;Nominal&#34;&#62;)&#60;30 THEN IF StrToFloat(&#60;Lianoz.&#34;Rtgk&#34;&#62;)&#60;&#62;0 Then IF &#60;Lianoz.&#34;Rtgk&#34;&#62;&#60;10000 THEN frxDBDataset1R.Text=&#60;Lianoz.&#34;Rtgk&#34;&#62;&#13;&#10;IF StrToFloat(&#60;Spc.&#34;Nominal&#34;&#62;)&#62;30 THEN IF StrToFloat(&#60;Lianoz.&#34;R&#34;&#62;)&#60;&#62;0 Then IF &#60;Lianoz.&#34;R&#34;&#62;&#60;10000 THEN frxDBDataset1R.Text=&#60;Lianoz.&#34;R&#34;&#62;  &#13;&#10;end sub  &#13;&#10;&#13;&#10;sub ColumnHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Ftgk&#34;&#62;=&#34;True&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFtgk&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmax=StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRmax&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmin=StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRmax&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0_C1max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0_C1max=StrToFloat(&#60;Spc.&#34;C0_C1max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;C0_C1max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0_C1min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0_C1min=StrToFloat(&#60;Spc.&#34;C0_C1min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;C0_C1min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; Then Smax=StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskSR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; Then Smin=StrToFloat(&#60;Spc.&#34;Rsp1min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rsp1min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskSR&#34;&#62;)/100    &#13;&#10;&#13;&#10;Rmax=Round(Rmax)&#13;&#10;Rmin=Round(Rmin)&#13;&#10;Fmaxmax=Round(Fmaxmax)&#13;&#10;Fminmin=Round(Fminmin)&#13;&#10;Fmax=Round(Fmax)&#13;&#10;Fmin=Round(Fmin)    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo93.Text=&#60;Spc.&#34;C0max&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo92.Text=&#60;Spc.&#34;C0min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0_C1max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo71.Text=&#60;Spc.&#34;C0_C1max&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;C0_C1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo70.Text=&#60;Spc.&#34;C0_C1min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;)&#60;500 Then Memo26.Text=&#60;Spc.&#34;Rsp1max&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo30.Text=&#60;Spc.&#34;Rsp1min&#34;&#62;    &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo45.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo44.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo55.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;    &#13;&#10;&#13;&#10;    &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo42.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#60;0 THEN Memo42.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#62;0 THEN Memo43.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))  &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo43.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))  &#13;&#10;  &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;C0_C1max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo97.Text=FloatToStr(Round(C0_C1max))  &#13;&#10;IF &#60;Spc.&#34;C0_C1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo96.Text=FloatToStr(Round(C0_C1min))  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo61.Text=FloatToStr(Round(Rmax))  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo60.Text=FloatToStr(Round(Rmin))&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo69.Text=FloatToStr(Round(C0max))  &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo68.Text=FloatToStr(Round(C0min))  &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo63.Text=FloatToStr(Rmaxmax)&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo54.Text=FloatToStr(Rmaxmin)&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF Smax&#60;500 Then Memo25.Text=FloatToStr(Smax)&#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo27.Text=FloatToStr(Smin)    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo59.Text=&#34;+&#34;+FloatToStr(Fmaxmax)  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo59.Text=FloatToStr(Fmaxmax)    &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#60;0 THEN Memo58.Text=FloatToStr(Fminmin)&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#62;0 THEN Memo58.Text=&#34;+&#34;+FloatToStr(Fminmin)&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo56.Text=&#34;+&#34;+FloatToStr(Round(Fmax))  &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo57.Text=&#34;-&#34;+FloatToStr(Round(Fmax))    &#13;&#10;  &#13;&#10;end sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Lianoz.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo51.Text=&#34;���&#34;  &#13;&#10;&#13;&#10;end sub&#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;  dim dat as String                      &#13;&#10;        dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)                                          &#13;&#10;        BarCode1.Expression=dat  &#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
