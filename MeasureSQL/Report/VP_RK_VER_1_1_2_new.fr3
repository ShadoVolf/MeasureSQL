<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="45114.3803351042" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;     dim dat as String                      &#13;&#10;        dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)                                          &#13;&#10;        BarCode1.Expression=dat&#13;&#10;end sub&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-(Abs(StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)))*StrToFloat(&#60;Spc.&#34;DopuskF_P&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+(Abs(StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)))*StrToFloat(&#60;Spc.&#34;DopuskF_P&#34;&#62;)/100   &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100    &#13;&#10;      &#13;&#10;Fmaxmax=(Round(Fmaxmax*10))/10        &#13;&#10;Fminmin=(Round(Fminmin*10))/10        &#13;&#10;Fmax=Round(Fmax)&#13;&#10;Fmin=Round(Fmin)                                               &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo59.Text=&#34;+&#34;+FloatToStr(Fmaxmax)  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo59.Text=FloatToStr(Fmaxmax)    &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#60;0 THEN Memo58.Text=FloatToStr(Fminmin)  &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#62;0 THEN Memo58.Text=&#34;+&#34;+FloatToStr(Fminmin)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo56.Text=&#34;+&#34;+FloatToStr(Fmax)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo57.Text=FloatToStr(Fmin)&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo22.Text=FloatToStr(Rmax)                                  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo23.Text=FloatToStr(Rmin)  &#13;&#10;&#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
