<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="42041.5397195486" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended    &#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;Dim Mmax As Extended&#13;&#10;Dim Mmin As Extended&#13;&#10;Dim Rsp1max As Extended&#13;&#10;Dim Rsp1min As Extended&#13;&#10;Dim Oldmax As Extended&#13;&#10;Dim Oldmin As Extended&#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended    &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;    &#13;&#10;IF &#60;Lianoz.&#34;F&#34;&#62;&#62;0 Then  Memo24.Text=&#34;+&#34;+FloatToStr(Round(&#60;Lianoz.&#34;F&#34;&#62;*&#60;Spc.&#34;Nominal&#34;&#62;))          &#13;&#10;IF &#60;Lianoz.&#34;F&#34;&#62;&#60;0 Then  Memo24.Text=FloatToStr(Round(&#60;Lianoz.&#34;F&#34;&#62;*&#60;Spc.&#34;Nominal&#34;&#62;))    &#13;&#10;end sub  &#13;&#10;&#13;&#10;sub ColumnHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;-(Abs(StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskF_P&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;+(Abs(StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskF_P&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100   &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;old1max&#34;&#62;&#60;&#62;&#34;no&#34; Then Oldmax=StrToFloat(&#60;Spc.&#34;old1max&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;old1min&#34;&#62;&#60;&#62;&#34;no&#34; Then Oldmin=StrToFloat(&#60;Spc.&#34;old1min&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmax=StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmin=StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; Then Rsp1=StrToFloat(&#60;Spc.&#34;Rsp1max&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; Then Rsp1=StrToFloat(&#60;Spc.&#34;Rsp1min&#34;&#62;)    &#13;&#10;  &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo22.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo23.Text=&#60;Spc.&#34;Rmaxmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo45.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo44.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo42.Text=&#34;+&#34;+FloatToStr(Round(StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#60;0 THEN Memo42.Text=&#34;-&#34;+FloatToStr(Round(StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#62;0 THEN Memo43.Text=&#34;+&#34;+FloatToStr(Round(StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;))&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo43.Text=&#34;-&#34;+FloatToStr(Round(StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)*&#60;Spc.&#34;Nominal&#34;&#62;))      &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo25.Text=&#60;Spc.&#34;C0max&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo26.Text=&#60;Spc.&#34;C0min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo27.Text=&#60;Spc.&#34;Cqmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo30.Text=&#60;Spc.&#34;Cqmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Mmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo47.Text=&#60;Spc.&#34;Mmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rsp1max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo53.Text=&#60;Spc.&#34;Rsp1max&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rsp1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo55.Text=&#60;Spc.&#34;Rsp1min&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;old1max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo60.Text=&#60;Spc.&#34;old1max&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;old1min&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo61.Text=&#60;Spc.&#34;old1min&#34;&#62;    &#13;&#10;Fmaxmax=(Round(Fmaxmax*10))/10        &#13;&#10;Fminmin=(Round(Fminmin*10))/10        &#13;&#10;Fmax=Round(Fmax)&#13;&#10;Fmin=Round(Fmin)                                               &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo59.Text=&#34;+&#34;+FloatToStr(Fmaxmax)  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo59.Text=FloatToStr(Fmaxmax)    &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#60;0 THEN Memo58.Text=FloatToStr(Fminmin)  &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#62;0 THEN Memo58.Text=&#34;+&#34;+FloatToStr(Fminmin)&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo56.Text=&#34;+&#34;+FloatToStr(Fmax)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo57.Text=FloatToStr(Fmin)    &#13;&#10;    &#13;&#10;end sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;                                                                                    &#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
