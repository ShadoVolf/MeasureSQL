<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="44279.5009962963" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended    &#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;Dim FFmax As Extended&#13;&#10;Dim FFmin As Extended&#13;&#10;Dim FF3 As Extended    &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;          FFmax=StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;)&#13;&#10;          FFmin=StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;)                          &#13;&#10;          IF abs(FFmax)&#62;=abs(FFmin) Then FF3=FFmax&#13;&#10;          IF abs(FFmax)&#60;abs(FFmin) Then FF3=FFmin                                                                                     &#13;&#10;          LianozFmaxm.Text=FormatFloat(&#34;0.0&#34;,FF3)      &#13;&#10;end sub  &#13;&#10;&#13;&#10;sub ColumnHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100   &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmax=StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmin=StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Tmaxmax=StrToFloat(&#60;Spc.&#34;Tmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskT&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Tmaxmin=StrToFloat(&#60;Spc.&#34;Tmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskT&#34;&#62;)  &#13;&#10;  &#13;&#10;  &#13;&#10;&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo23.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo22.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo45.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;      &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo44.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN  Memo42.Text=&#60;Spc.&#34;Fmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN  Memo43.Text=&#60;Spc.&#34;Fmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN  Memo47.Text=&#60;Spc.&#34;Mmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN  Memo53.Text=&#60;Spc.&#34;Mmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN  Memo64.Text=&#60;Spc.&#34;Tmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN  Memo66.Text=&#60;Spc.&#34;Tmaxmin&#34;&#62;    &#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo61.Text=FloatToStr(Rmax)&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo60.Text=FloatToStr(Rmin)&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo59.Text=FloatToStr(Fmaxmax)&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo58.Text=FloatToStr(Fminmin)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo57.Text=FloatToStr(Fmin)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo56.Text=FloatToStr(Fmax)    &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=FloatToStr(Tmaxmax)&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo65.Text=FloatToStr(Tmaxmin)&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=FloatToStr(Mmax)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo51.Text=FloatToStr(Mmin)    &#13;&#10;end sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)  &#13;&#10;IF &#60;Spc.&#34;PrintProfile&#34;&#62;=41 Then Memo54.Text=&#34;�� 070.052&#34;                                                                                    &#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
