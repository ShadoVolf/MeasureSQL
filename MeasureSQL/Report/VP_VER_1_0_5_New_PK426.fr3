<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40982.4366122222" ReportOptions.Description.Text="" ReportOptions.LastChange="46338.5310244676" ScriptLanguage="BasicScript" ScriptText.Text="Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended    &#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;&#13;&#10;Dim Numbers_line as String                                                                        &#13;&#10;Dim count_ as Integer&#13;&#10;count_ =0&#13;&#10;Numbers_line = &#34; &#34;  &#13;&#10;&#13;&#10;  &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;      count_ = count_ + 1&#13;&#10;&#13;&#10;    IF count_ = 1 THEN&#13;&#10;        Numbers_line = &#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;    ELSE&#13;&#10;        Numbers_line = Numbers_line + &#34;, &#34; + &#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;    END IF&#13;&#10;&#13;&#10;    IF count_ &#60;= 10 THEN&#13;&#10;        Memo34.Text = Numbers_line&#13;&#10;    ELSE&#13;&#10;        Memo34.Text = &#34;� ���������� &#34; + FloatToStr(count_) + &#34; ��&#34;&#13;&#10;    END IF      &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#62;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#34;+&#34;+FloatToStr(&#60;Lianoz.&#34;Ftgk&#34;&#62;)      &#13;&#10;IF StrToFloat(&#60;Lianoz.&#34;Ftgk&#34;&#62;)&#60;0 Then IF &#60;Lianoz.&#34;Ftgk&#34;&#62;&#60;10000 THEN Memo24.Text=&#60;Lianoz.&#34;Ftgk&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rtgk&#34;&#62;=&#34;True&#34; THEN IF &#60;Lianoz.&#34;Rtgk&#34;&#62;&#60;&#62;0 Then IF &#60;Lianoz.&#34;Rtgk&#34;&#62;&#60;10000  THEN Memo55.Text=&#60;Lianoz.&#34;Rtgk&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rtgk&#34;&#62;=&#34;False&#34; THEN Memo55.Text=FormatFloat(&#34;0.0&#34;,StrToFloat(&#60;Lianoz.&#34;R&#34;&#62;))      &#13;&#10;IF Abs(StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;))&#62;=Abs(StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;)) THEN LianozFmaxm.Text=FormatFloat(&#34;0.0&#34;,StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;))  &#13;&#10;IF Abs(StrToFloat(&#60;Lianoz.&#34;Fmax&#34;&#62;))&#60;Abs(StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;)) THEN LianozFmaxm.Text=FormatFloat(&#34;0.0&#34;,StrToFloat(&#60;Lianoz.&#34;Fmin&#34;&#62;))    &#13;&#10;end sub  &#13;&#10;&#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Ftgk&#34;&#62;=&#34;True&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;FnastrHZ&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFtgk&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRtgk&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRtgk&#34;&#62;)/100   &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmax=StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fminmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fminmin=StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62; &#60;&#62;&#34;no&#34; Then RRmax=StrToFloat(&#60;Spc.&#34;RR2max&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;RR2max&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo45.Text=&#60;Spc.&#34;RR2max&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo46.Text=&#60;Spc.&#34;Rmax&#34;&#62;  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo62.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#62;0 THEN Memo30.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)&#60;0 THEN Memo30.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo31.Text=&#34;+&#34;+&#60;Spc.&#34;Fmaxmax&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo31.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo42.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#60;0 THEN Memo42.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#62;0 THEN Memo43.Text=&#34;+&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo43.Text=&#34;-&#34;+FloatToStr(Round(&#60;Spc.&#34;FnastrHZ&#34;&#62;))      &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;RR2max&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo25.Text=FloatToStr(RRmax)&#13;&#10;                                  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo61.Text=FormatFloat(&#34;0.0&#34;,Rmax)  &#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN Memo60.Text=FormatFloat(&#34;0,0&#34;,Rmin)&#13;&#10;                                               &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#62;0 THEN Memo59.Text=&#34;+&#34;+FormatFloat(&#34;0.00&#34;,Fmaxmax)  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)&#60;0 THEN Memo59.Text=FormatFloat(&#34;0.00&#34;,Fmaxmax)    &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#60;0 THEN Memo58.Text=FormatFloat(&#34;0.00&#34;,Fminmin)  &#13;&#10;IF &#60;Spc.&#34;Fminmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fminmin&#34;&#62;)&#62;0 THEN Memo58.Text=&#34;+&#34;+FormatFloat(&#34;0.00&#34;,Fminmin)&#13;&#10;&#13;&#10;      &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)&#62;0 THEN Memo56.Text=&#34;+&#34;+FloatToStr(Round(Fmax))&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; THEN IF StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)&#60;0 THEN Memo57.Text=&#34;-&#34;+FloatToStr(Round(Fmax))    &#13;&#10;IF &#60;Lianoz.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo51.Text=&#34;���&#34;&#13;&#10;IF &#60;Lianoz.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo67.Text=&#34;���&#34;&#13;&#10;IF &#60;Lianoz.&#34;PMI&#34;&#62;=&#34;True&#34; THEN Memo68.Text=&#34;���&#34;    &#13;&#10;IF &#60;Spc.&#34;PrintProfile&#34;&#62;=41 Then Memo54.Text=&#34;�� 070.052&#34;                                                                                    &#13;&#10;end sub&#13;&#10;&#13;&#10;sub PageFooter1OnBeforePrint(Sender)&#13;&#10; IF &#60;Spc.&#34;PrintProfile&#34;&#62;=41 Then Memo54.Text=&#34;�� 070.052&#34;  &#13;&#10;end sub&#13;&#10;  &#13;&#10;&#13;&#10;sub ReportTitle1OnBeforePrint(Sender)&#13;&#10;        dim dat as String                      &#13;&#10;        dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;)                                          &#13;&#10;        BarCode1.Expression=dat  &#13;&#10;end sub&#13;&#10;&#13;&#10;                 " PropData="">
