<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="46338.4141285648" ScriptLanguage="BasicScript" ScriptText.Text="    &#13;&#10;&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended    &#13;&#10;Dim Mmax As Extended&#13;&#10;Dim Mmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;Dim Fminmax As Extended&#13;&#10;Dim Fminmin As Extended&#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended&#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rsp1max As Extended&#13;&#10;Dim Rsp1min As Extended&#13;&#10;Dim �max As Extended&#13;&#10;Dim �min As Extended&#13;&#10;Dim C0_C1max As Extended&#13;&#10;Dim C0_C1min As Extended&#13;&#10;Dim Numbers_line as String                                                                        &#13;&#10;Dim count_ as Integer&#13;&#10;count_ =0&#13;&#10;Numbers_line = &#34; &#34;                &#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;&#13;&#10;    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100   &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmax=StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmin=StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62; &#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62; &#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then �max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then �min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0_C1max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0_C1max=StrToFloat(&#60;Spc.&#34;C0_C1max&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;C0_C1min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0_C1min=StrToFloat(&#60;Spc.&#34;C0_C1min&#34;&#62;)    &#13;&#10;    &#13;&#10;&#13;&#10;              &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo42.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo43.Text=&#60;Spc.&#34;Rmin&#34;&#62;                  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo46.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmaxmin