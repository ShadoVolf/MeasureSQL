<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="46338.5513689583" ScriptLanguage="BasicScript" ScriptText.Text="    &#13;&#10;    &#13;&#10;Dim Qmax As Extended&#13;&#10;Dim Qmin As Extended&#13;&#10;Dim Rmaxmax As Extended&#13;&#10;Dim Rmaxmin As Extended&#13;&#10;Dim Fptpmax As Extended&#13;&#10;Dim Fptpmin As Extended&#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended&#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim Oldmax As Extended&#13;&#10;Dim Oldmin As Extended&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;))      &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmax=StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskQ&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmin=StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskQ&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmax=StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Rmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmaxmin=StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Rmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fptpmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fptpmax=StrToFloat(&#60;Spc.&#34;Fptpmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fptpmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFptp&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fptpmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fptpmin=StrToFloat(&#60;Spc.&#34;Fptpmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fptpmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFptp&#34;&#62;)/100      &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62; &#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100                     &#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62; &#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100  &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62; &#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100                     &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62; &#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo48.Text=&#60;Spc.&#34;Rmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo49.Text=&#60;Spc.&#34;Rmaxmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo50.Text=&#60;Spc.&#34;Qmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo51.Text=&#60;Spc.&#34;Qmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#6