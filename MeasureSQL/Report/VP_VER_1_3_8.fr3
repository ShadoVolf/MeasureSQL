<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="42569.5516861921" ScriptLanguage="BasicScript" ScriptText.Text="    &#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Qmax As Extended&#13;&#10;Dim Qmin As Extended    &#13;&#10;Dim C0max As Extended&#13;&#10;Dim C0min As Extended&#13;&#10;Dim Cqmax As Extended&#13;&#10;Dim Cqmin As Extended&#13;&#10;Dim RRmax As Extended&#13;&#10;Dim RRmin As Extended    &#13;&#10;Dim Tmaxmax As Extended&#13;&#10;Dim Tmaxmin As Extended&#13;&#10;Dim RcRbmax As Extended&#13;&#10;    &#13;&#10;    &#13;&#10;sub MasterData1OnBeforePrint(Sender)                &#13;&#10;&#13;&#10;&#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then C0max=StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;C0max&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then C0min=StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;C0min&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskC0&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmax=StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Cqmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Cqmin=StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Cqmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskCq&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;RRmax&#34;&#62;&#60;&#62;&#34;no&#34; Then RRmax=StrToFloat(&#60;Spc.&#34;RRmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;RRmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;RRmin&#34;&#62;&#60;&#62;&#34;no&#34; Then RRmin=StrToFloat(&#60;Spc.&#34;RRmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;RRmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRR&#34;&#62;)/100    &#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmax=StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Qmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskQ&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Qmin=StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;Qmin&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskQ&#34;&#62;)/100  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)  &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Tmaxmax=StrToFloat(&#60;Spc.&#34;Tmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskT&#34;&#62;)                            &#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Tmaxmin=StrToFloat(&#60;Spc.&#34;Tmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskT&#34;&#62;)        &#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then RcRbmax=StrToFloat(&#60;Spc.&#34;Rc_Rbmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;Rc_Rbmax&#34;&#62;)*StrToFloat(&#60;Spc.&#34;DopuskRcRb&#34;&#62;)/100&#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo42.Text=&#60;Spc.&#34;Fmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo43.Text=&#60;Spc.&#34;Fmin&#34;&#62;              &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo44.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo45.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo46.Text=&#60;Spc.&#34;Qmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Qmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo47.Text=&#60;Spc.&#34;Qmin&#34;&#62;                  &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo52.Text=&#60;Spc.&#34;Tmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo53.Text=&#60;Spc.&#34;Tmaxmin&#34;&#62;                   &#13;&#10;IF &#60;Spc.&#34;C0max&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo48.Text=&#60;Spc.&#34;C0max&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;C0min&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo49.Text=&#60;Spc.&#34;C0min&#34;&#62;                   &#13;&#10;IF &#60;Spc.&#34;Cqmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo50.Text=&#60;Spc.&#34;Cqmax&#34;&#62;            &#13;&#10;IF &#60;Spc.&#34;Cqmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo51.Text=&#60;Spc.&#34;Cqmin&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;RRmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo41.Text=&#60;Spc.&#34;RRmax&#34;&#62;            &#13;&#10;IF &#60;Spc.&#34;RRmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo56.Text=&#60;Spc.&#34;RRmin&#34;&#62;    &#13;&#10;IF &#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo54.Text=&#60;Spc.&#34;Rc_Rbmax&#34;&#62;&#13;&#10;    &#13;&#10;    &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo36.Text=FloatToStr(Tmaxmax)&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo37.Text=FloatToStr(Tmaxmin)         &#13;