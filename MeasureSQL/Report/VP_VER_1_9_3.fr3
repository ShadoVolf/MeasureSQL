.&#34;Cqmax&#34;&#62;&#13;&#10;  IF &#60;Spc.&#34;Cqmin&#34;&#62; &#60;&#62; &#34;no&#34; THEN Memo28.Text=&#60;Spc.&#34;Cqmin&#34;&#62;      &#13;&#10;   frxDBDataset1Shum.Text=FloatToStr(Abs((Round(StrToFloat(&#60;Lianoz.&#34;Shum&#34;&#62;)*10)/10)))  &#13;&#10;&#13;&#10;end sub&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;dim dat as String                      &#13;&#10;dat=&#34;801&#34;+FloatToStr(&#60;Lianoz.&#34;Measure_Protokol_ID&#34;&#62;+&#60;Page&#62;)                                          &#13;&#10;    BarCode1.Expression=dat                                                                                                          &#13;&#10;&#13;&#10;end sub    " PropData="">
