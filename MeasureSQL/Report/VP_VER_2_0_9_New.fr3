<TfrxReport Version="4.9" DotMatrixReport="false" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40525.6070809722" ReportOptions.Description.Text="" ReportOptions.LastChange="46339.5926972338" ScriptLanguage="BasicScript" ScriptText.Text="    &#13;&#10;&#13;&#10;Dim TOmax As Extended&#13;&#10;Dim TOmin As Extended    &#13;&#10;Dim Mmax As Extended&#13;&#10;Dim Mmin As Extended&#13;&#10;Dim Rmax As Extended&#13;&#10;Dim Rmin As Extended&#13;&#10;Dim Fmaxmax As Extended&#13;&#10;Dim Fmaxmin As Extended&#13;&#10;&#13;&#10;Dim Fmax As Extended&#13;&#10;Dim Fmin As Extended    &#13;&#10;&#13;&#10;sub PageHeader1OnBeforePrint(Sender)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmax=StrToFloat(&#60;Spc.&#34;Fmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;))    &#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmin=StrToFloat(&#60;Spc.&#34;Fmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;DopuskF&#34;&#62;))      &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmax=StrToFloat(&#60;Spc.&#34;Mmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Dopusk_M&#34;&#62;))      &#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Mmin=StrToFloat(&#60;Spc.&#34;Mmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Dopusk_M&#34;&#62;))          &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then TOmax=StrToFloat(&#60;Spc.&#34;Tmaxmax&#34;&#62;)-StrToFloat(&#60;Spc.&#34;DopuskT&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then TOmin=StrToFloat(&#60;Spc.&#34;Tmaxmin&#34;&#62;)+StrToFloat(&#60;Spc.&#34;DopuskT&#34;&#62;)&#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmax=StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Rmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Rmin=StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Rmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskR&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmax=StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;)-Abs(StrToFloat(&#60;Spc.&#34;Fmaxmax&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100&#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Fmaxmin=StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;)+Abs(StrToFloat(&#60;Spc.&#34;Fmaxmin&#34;&#62;))*StrToFloat(&#60;Spc.&#34;DopuskFi&#34;&#62;)/100      &#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo46.Text=&#60;Spc.&#34;Tmaxmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo47.Text=&#60;Spc.&#34;Tmaxmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo42.Text=&#60;Spc.&#34;Rmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo43.Text=&#60;Spc.&#34;Rmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo59.Text=&#60;Spc.&#34;Mmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo60.Text=&#60;Spc.&#34;Mmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo54.Text=&#60;Spc.&#34;Fmaxmax&#34;&#62;            &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo55.Text=&#60;Spc.&#34;Fmaxmin&#34;&#62;&#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo29.Text=&#60;Spc.&#34;Fmax&#34;&#62;&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo38.Text=&#60;Spc.&#34;Fmin&#34;&#62;    &#13;&#10;  &#13;&#10;  &#13;&#10;IF &#60;Spc.&#34;Rmax&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo26.Text=FloatToStr(Rmax)&#13;&#10;IF &#60;Spc.&#34;Rmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo27.Text=FloatToStr(Rmin)         &#13;&#10;IF &#60;Spc.&#34;Fmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo57.Text=FloatToStr(Fmaxmin)&#13;&#10;IF &#60;Spc.&#34;Fmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo56.Text=FloatToStr(Fmaxmax)&#13;&#10;IF &#60;Spc.&#34;Mmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo62.Text=FloatToStr(Round(Mmin*10)/10)&#13;&#10;IF &#60;Spc.&#34;Mmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo61.Text=FloatToStr(Round(Mmax*10)/10)&#13;&#10;IF &#60;Spc.&#34;Tmaxmin&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo31.Text=FloatToStr(TOmin)&#13;&#10;IF &#60;Spc.&#34;Tmaxmax&#34;&#62;&#60;&#62;&#34;no&#34; Then    Memo30.Text=FloatToStr(TOmax)&#13;&#10;IF &#60;Spc.&#34;Fmax&#34;&#62;&#60;&#62;&#34;no&#34; Then  Memo13.Text=FloatToStr(Fmax)&#13;&#10;IF &#60;Spc.&#34;Fmin&#34;&#62;&#60;&#62;&#34;no&#34; Then Memo28.Text=FloatToStr(Fmin)  &#13;&#10;&#13;&#10;end sub  &#13;&#10;&#13;&#10;&#13;&#10;Dim S As String&#13;&#10;Dim LN1 As Integer    &#13;&#10;Dim Subs As String&#13;&#10;  &#13;&#10;Dim Numbers_line as String                                                                        &#13;&#10;Dim count_ as Integer&#13;&#10;count_ =0&#13;&#10;Numbers_line = &#34; &#34;&#13;&#10;  &#13;&#10;sub MasterData1OnBeforePrint(Sender)&#13;&#10;S=&#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;Subs=Copy(S,0,1)&#13;&#10;LN1=Length(S)                            &#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;LN1=Length(S)    &#13;&#10;Subs=Copy(S,0,1)&#13;&#10;IF (Subs=&#34;0&#34;) THEN S=Copy(S,2,LN1)&#13;&#10;frxDBDataset1N.Text=S  &#13;&#10;      count_ = count_ + 1&#13;&#10;&#13;&#10;    IF count_ = 1 THEN&#13;&#10;        Numbers_line = &#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;    ELSE&#13;&#10;        Numbers_line = Numbers_line + &#34;, &#34; + &#60;Lianoz.&#34;N&#34;&#62;&#13;&#10;    END IF&#13;&#10;&#13;&#10;    IF count_ &#60;= 10 THEN&#13;&#10;        Memo22.Text = Numbers_line&#13;&#10;    ELSE&#13;&#10;        Memo22.Text = &#34;� ���������� &#34; + FloatToStr(count_) + &#34; ��&#34;&#13;&#10;    END IF    &#13;&#10;end sub&#13;&#10;&#13;&#10;  " PropData="">
