  object frxReport1: TfrxReport
    Version = '4.9'
    DotMatrixReport = False
    IniFile = '\Software\Fast Reports'
    PreviewOptions.Buttons = [pbPrint, pbLoad, pbSave, pbExport, pbZoom, pbFind, pbOutline, pbPageSetup, pbTools, pbEdit, pbNavigator, pbExportQuick]
    PreviewOptions.Zoom = 1
    PrintOptions.Printer = 'Default'
    PrintOptions.PrintOnSheet = 0
    ReportOptions.CreateDate = 40525.6070809722
    ReportOptions.LastChange = 41956.6847247917
    ScriptLanguage = 'BasicScript'
    ScriptText.Strings = (
      '    '
      'Dim Fmax As Extended'
      'Dim Fmin As Extended'
      'Dim Rmax As Extended'
      'Dim Rmin As Extended'
      'Dim Qmax As Extended'
      'Dim Qmin As Extended    '
      'Dim C1_2C0min As Extended'
      'Dim C1_2C0max As Extended'
      'Dim Fptpmax As Extended'
      'Dim Fptpmin As Extended'
      '  '
      '      '
      '    '
      'sub MasterData1OnBeforePrint(Sender)                '
      ''
      ''
      ''
      
        'IF <Spc."C1_2C0max"><>"no" Then C1_2C0max=StrToFloat(<Spc."C1_2C' +
        '0max">)-Abs(StrToFloat(<Spc."C1_2C0max">))*StrToFloat(<Spc."Dopu' +
        'skC1_2C0">)/100  '
      
        'IF <Spc."C1_2C0min"><>"no" Then C1_2C0min=StrToFloat(<Spc."C1_2C' +
        '0min">)+Abs(StrToFloat(<Spc."C1_2C0min">))*StrToFloat(<Spc."Dopu' +
        'skC1_2C0">)/100'
      
        'IF <Spc."Rmax"><>"no" Then Rmax=StrToFloat(<Spc."Rmax">)-StrToFl' +
        'oat(<Spc."Rmax">)*StrToFloat(<Spc."DopuskR">)/100'
      
        'IF <Spc."Rmin"><>"no" Then Rmin=StrToFloat(<Spc."Rmin">)+StrToFl' +
        'oat(<Spc."Rmin">)*StrToFloat(<Spc."DopuskR">)/100   '
      
        'IF <Spc."Qmax"><>"no" Then Qmax=StrToFloat(<Spc."Qmax">)-StrToFl' +
        'oat(<Spc."Qmax">)*StrToFloat(<Spc."DopuskQ">)/100'
      
        'IF <Spc."Qmin"><>"no" Then Qmin=StrToFloat(<Spc."Qmin">)+StrToFl' +
        'oat(<Spc."Qmin">)*StrToFloat(<Spc."DopuskQ">)/100  '
      
        'IF <Spc."Fmax"><>"no" Then Fmax=StrToFloat(<Spc."Fmax">)-StrToFl' +
        'oat(<Spc."DopuskF">)  '
      
        'IF <Spc."Fmin"><>"no" Then Fmin=StrToFloat(<Spc."Fmin">)+StrToFl' +
        'oat(<Spc."DopuskF">)'
      
        'IF <Spc."Fptpmax"><>"no" Then Fptpmax=StrToFloat(<Spc."Fptpmax">' +
        ')-Abs(StrToFloat(<Spc."Fptpmax">))*StrToFloat(<Spc."DopuskFptp">' +
        ')/100                            '
      
        'IF <Spc."Fptpmin"><>"no" Then Fptpmin=StrToFloat(<Spc."Fptpmin">' +
        ')+Abs(StrToFloat(<Spc."Fptpmin">))*StrToFloat(<Spc."DopuskFptp">' +
        ')/100        '
      '                           '
      ''
      '    '
      ''
      '  '
      'IF <Spc."Fmax"><>"no" Then  Memo42.Text=<Spc."Fmax">'
      
        'IF <Spc."Fmin"><>"no" Then Memo43.Text=<Spc."Fmin">             ' +
        ' '
      'IF <Spc."Rmax"><>"no" Then Memo44.Text=<Spc."Rmax">'
      'IF <Spc."Rmin"><>"no" Then Memo45.Text=<Spc."Rmin">'
      'IF <Spc."Qmax"><>"no" Then Memo46.Text=<Spc."Qmax">'
      
        'IF <Spc."Qmin"><>"no" Then Memo47.Text=<Spc."Qmin">             ' +
        '     '
      'IF <Spc."Tminmax"><>"no" Then Memo52.Text=<Spc."Tminmax">'
      'IF <Spc."Tminmin"><>"no" Then Memo53.Text=<Spc."Tminmin">  '
      
        'IF <Spc."C1_2C0max"><>"no" Then Memo54.Text=<Spc."C1_2C0max">   ' +
        '         '
      
        'IF <Spc."C1_2C0min"><>"no" Then Memo55.Text=<Spc."C1_2C0min">   ' +
        ' '
      '      '
      '    '
      '  '
      'IF <Spc."Tminmax"><>"no" Then Memo36.Text=FloatToStr(Fptpmax)'
      
        'IF <Spc."Tminmin"><>"no" Then Memo37.Text=FloatToStr(Fptpmin)   ' +
        '      '
      'IF <Spc."Qmin"><>"no" Then    Memo31.Text=FloatToStr(Qmin)'
      'IF <Spc."Qmax"><>"no" Then    Memo30.Text=FloatToStr(Qmax)'
      'IF <Spc."Fmin"><>"no" Then    Memo27.Text=FloatToStr(Fmin)'
      'IF <Spc."Fmax"><>"no" Then    Memo26.Text=FloatToStr(Fmax)'
      'IF <Spc."Rmin"><>"no" Then    Memo29.Text=FloatToStr(Rmin)'
      'IF <Spc."Rmax"><>"no" Then    Memo28.Text=FloatToStr(Rmax)'
      
        'IF <Spc."C1_2C0max"><>"no" Then Memo38.Text=FloatToStr(Round(C1_' +
        '2C0max*10)/10)        '
      
        'IF <Spc."C1_2C0min"><>"no" Then Memo39.Text=FloatToStr(Round(C1_' +
        '2C0min*10)/10)    '
      '  '
      ''
      'end sub')
    Left = 408
    Top = 304
    Datasets = <
      item
        DataSet = Dopusk
        DataSetName = 'Dopusk'
      end
      item
        DataSet = Lianoz
